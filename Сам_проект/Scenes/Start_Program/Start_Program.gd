## fxG_EstablishingConnection_CrTr в _fC_StartClientConnection_Ch) — это
## значение просто ограничивает, сколько ждать РЕЗУЛЬТАТА этой попытки, прежде
## чем показать кнопку "Продолжить без сервера"; сам клиент при этом не
## переподключается повторно, пока не откроется сокет хотя бы раз (fC_Reconnect_Ch
## вызывается только ПОСЛЕ разрыва уже открытого соединения, см. changelog
## Class_InternetClient.gd _process) — если разрешить "лишние" попытки при
## неудачном connect_to_url, менять здесь и/или в _fC_StartClientConnection_Ch
const SERVER_CONNECT_TIMEOUT_SECONDS_F := 8.0

var _vLB_ClientConnectionStarted_Bv := false
var _vLB_ServerCheckResolved_Bv := false
var _vLB_CredentialsSent_Bv := false
var _vLB_AutonomousModeOffered_Bv := false
var _vLF_ServerConnectAttemptStartedAtMsec_F := 0.0

## 2026-08-24 (по просьбе пользователя "добавим... регистрацию для входа"):
## true — текущая попытка подключения начата через "Зарегистрироваться" (см.
## _fC_OnAccountAddRegisterPressed_Ch), а не через выбор существующего
## аккаунта. Пока true, AUTHENTICATING-ветка _process шлёт Op "Register"
## вместо обычного AuthRequest (см. _fC_SendRegistrationRequest_Ch) — сама
## Class_InternetClient ничего не знает про регистрацию, различие полностью
## на стороне Start_Program. Сбрасывается в false в _fC_HandleRegisterResult_Ch
## (и успехом, и провалом — при успехе следующий кадр уже логинится обычным
## путём под тем же логином/паролем, при провале попытка просто прекращается)
var _vLB_PendingRegistration_Bv := false
var _vLB_RegistrationSent_Bv := false

## true — пользователь осознанно продолжил без сервера (см.
## _fC_OnAutonomousModePressed_Ch). 2026-08-23 (обратная связь "если
## подключаемся без сети — то все крестики"): "Server"/"Update"/
## "ThirdPartyFiles" в автономном режиме отмечаются "failed" (крестик), а не
## "passed" — честнее отражает "не проверено", а не "проверено и всё ок". Раз
## они больше не "passed", _fC_UpdateOverallProgress_Ch делает для них
## исключение именно по этому флагу (см. ниже), иначе чек-лист завис бы навсегда
var _vLB_AutonomousMode_Bv := false

## Версия ЭТОГО клиента — сверяется с сервером через Op "CheckUpdate" (см.
## _fC_SendUpdateCheckRequest_Ch). Пока просто константа в коде (см. пункт
## "вынести захардкоженные значения в настройки" в План проекта/Обзор проекта.md
## — сюда это тоже относится, но отдельным заходом); у test.gd — своя,
## "серверная" константа SERVER_LATEST_VERSION_S, с которой сверяется эта
const APP_VERSION_S := "0.1.0.0"


#Функционал:
#	Точка входа программы. Жёсткая последовательность с остановкой на первом
#	же провале — см. changelog про 2026-08-17 (нельзя увидеть интерфейс без
#	"галочки" логгера, нельзя пользоваться экраном без "галочки" интерфейса)
#Форматы данных:
#	Входные: нет
#	Выходные: нет
#Принцип работы:
#	1. Добавляет Class_UI в дерево сцены — без этого не работает get_tree()
#		внутри fC_CreatingNode_1000/fxC_SwitchingScene_0000
#	2. Запускает логгер и ЧЕСТНО проверяет результат ДО того, как строить
#		хоть что-то на экране. Провал — fC_FatalStartupError_Ch и выход,
#		дальше _ready() не идёт (интерфейса без рабочего логгера не будет)
#	3. Строит экран (это и есть проверка "Interface") и ЧЕСТНО проверяет,
#		что все ноды из конфига реально создались. Провал — та же
#		fC_FatalStartupError_Ch, экран не считается готовым к использованию
#	4. Только если оба шага прошли — статусы "Logger"/"Interface" в чек-листе
#		становятся "✓", остальные 3 проверки остаются "Ожидает проверки" —
#		их подключение (сетевой код) — следующий этап
func _ready() -> void:
	add_child(Class_UI)

	# Локализация и настройки — до сборки экрана, чтобы окно Поддержка/Настройки
	# сразу собиралось с правильным языком и чтобы сохранённый размер/режим окна
	# применился ДО того, как пользователь вообще увидит экран (см. changelog
	# 2026-08-19 про полную переработку окна настроек). Ошибку локализации
	# (если есть) сохраняем и показываем/логируем ПОЗЖЕ — ни лога (нет ещё
	# vLS_StreamId), ни экрана (InfoBoxLabel ещё не создан) на этом шаге нет
	var vLS_LocalizationError_S: String = Class_Localization.fxG_LoadLocalization_Ch()
	vXD_Settings_D = _fC_LoadSettings_Cr()
	# 2026-08-23: список аккаунтов грузим ДО _fC_BuildScreen_Ch() ниже — экран
	# выбора аккаунта собирается из vLD_AccountsList_D уже на первой сборке
	# (см. цикл в _fC_BuildScreenConfig_Cr)
	vLD_AccountsList_D = _fC_LoadAccountsList_Cr()
	Class_Localization.fC_SetLocale_Ch(vXD_Settings_D.get("Locale", "en"))
	if vXD_Settings_D.get("Fullscreen", false):
		get_window().mode = Window.MODE_FULLSCREEN
	else:
		get_window().mode = Window.MODE_WINDOWED
		get_window().size = Vector2i(
			int(vXD_Settings_D.get("ScreenWidth", vSV2_Scene_size_V2i.x)),
			int(vXD_Settings_D.get("ScreenHeight", vSV2_Scene_size_V2i.y))
		)

	Logger.fxG_StartingLogger_CrTr()
	vLS_StreamId = Logger.fC_RegisterStream_Cr("StartProgram")

	# Шаг 1: логгер — интерфейс ещё не существует, честную проверку делаем "вслепую"
	var vLB_LoggerOk: bool = Logger.FileLogger != "" and FileAccess.file_exists(Logger.FileLogger)
	if not vLB_LoggerOk:
		_fC_FatalStartupError_Ch("Логгер", "Не удалось запустить логгер — файл лога не создан.")
		return
	vLD_CheckStatuses_D["Logger"] = "passed"
	Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_ready: Logger check passed", [], null)

	# Шаг 2: интерфейс — сама попытка построить экран и есть эта проверка.
	# Статус "checking" выставляем ДО сборки, чтобы строка чек-листа сразу
	# появилась с "…", а не мелькнула "waiting" на один кадр
	vLD_CheckStatuses_D["Interface"] = "checking"
	_fC_BuildScreen_Ch()

	if not _fC_VerifyInterfaceBuilt_Bv():
		_fC_FatalStartupError_Ch("Интерфейс", "Не все элементы экрана удалось создать.")
		return
	fC_SetCheckStatus_Ch("Interface", "passed")
	Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_ready: Interface check passed", [], null)

	# 2026-08-23: проверка "Server" начинается с выбора аккаунта — см.
	# _fC_ShowAccountPicker_Ch. Update/ThirdPartyFiles по-прежнему не
	# подключены — следующий этап, как и раньше
	fC_SetCheckStatus_Ch("Server", "checking")
	_fC_ShowAccountPicker_Ch()

	# Живой перерасчёт размеров шрифта под окно (2026-08-19, "шрифт... должен
	# зависеть от размеров окна") — срабатывает и на ручное перетаскивание
	# края окна пользователем, и на наши fullscreen/пресеты в Настройках
	get_window().size_changed.connect(_fC_RescaleFonts_Ch)

	# Теперь и лог, и экран (InfoBoxLabel) точно готовы — можно безопасно
	# сообщить об ошибке локализации, если она была (п.3 ТЗ 2026-08-19: не
	# push_error, а окно с ошибками + лог, программа при этом не прерывается —
	# без переводов экран настроек просто покажет сырые ключи вместо текста)
	if vLS_LocalizationError_S != "":
		_fC_ReportError_Ch("Локализация", vLS_LocalizationError_S)


#Функционал:
#	2026-08-23: опрашивает состояние Class_InternetClient раз в кадр, пока
#	идёт (или ждём начала) подключение к серверу — сама библиотека
#	(Class_InternetClient) ничего не сигналит наружу, только меняет
#	vGE_State/ConnectionState, поэтому Start_Program следит за ним сама.
#	Ничего не делает, пока подключение ещё не запускалось
#	(_vLB_ClientConnectionStarted_Bv) или уже разрешилось
#	(_vLB_ServerCheckResolved_Bv — успешным подключением или автономным
#	режимом, см. _fC_OnServerConnected_Ch/_fC_OnAutonomousModePressed_Ch)
func _process(_vLF_Delta_F: float) -> void:
	if not _vLB_ClientConnectionStarted_Bv or _vLB_ServerCheckResolved_Bv:
		return

	_fC_UpdateConnectingTimerLabel_Ch()

	match Class_InternetClient.vGE_State:
		Class_InternetClient.ConnectionState.AUTHENTICATING:
			# 2026-08-24: попытка, начатая через "Зарегистрироваться" — сначала
			# Register, обычный вход (_fC_SendStoredCredentials_Ch) начнётся уже
			# на следующем кадре после успеха, см. _fC_HandleRegisterResult_Ch
			if _vLB_PendingRegistration_Bv:
				_fC_SendRegistrationRequest_Ch()
			else:
				_fC_SendStoredCredentials_Ch()
		Class_InternetClient.ConnectionState.CONNECTED:
			_fC_OnServerConnected_Ch()
		_:
			if not _vLB_AutonomousModeOffered_Bv and Time.get_ticks_msec() - _vLF_ServerConnectAttemptStartedAtMsec_F > SERVER_CONNECT_TIMEOUT_SECONDS_F * 1000.0:
				_fC_OfferAutonomousMode_Ch()


#Функционал:
#	2026-08-24 (обратная связь "когда подключаемся к серверу, в окошке снизу
#	должен появляться таймер, чтобы человек понимал, что подключение
#	работает"): раз в кадр, пока идёт попытка подключения (см. вызов из
#	_process выше — под той же охраной, что и вся остальная обвязка
#	подключения), обновляет текст InfoBoxConnectingLabel количеством
#	прошедших секунд от начала ЭТОЙ попытки (_vLF_ServerConnectAttemptStartedAtMsec_F
#	— выставляется в _fC_StartClientConnection_Ch, общая и для первой
#	попытки, и для повтора через InfoBoxRetryButton)
#Форматы данных:
#	Входные: нет
#	Выходные: нет
func _fC_UpdateConnectingTimerLabel_Ch() -> void:
	if not vSD_AllNodes_D.has("InfoBoxConnectingLabel"):
		return
	var vLI_ElapsedSeconds_I: int = int((Time.get_ticks_msec() - _vLF_ServerConnectAttemptStartedAtMsec_F) / 1000.0)
	vSD_AllNodes_D["InfoBoxConnectingLabel"]["Node"].text = "Подключение к серверу… %d сек" % vLI_ElapsedSeconds_I


#Функционал:
#	2026-08-20 — обратная связь: "добавь сворачивания окна на esc, если там
#	был выбор — он выбирается в сторону нет". Обрабатывает Esc
#	(is_action_pressed("ui_cancel") — стандартное действие Godot, по
#	умолчанию завязано на клавишу Escape независимо от раскладки клавиатуры)
#	и закрывает САМЫЙ ВЕРХНИЙ из открытых сейчас окон/попапов, по приоритету
#	сверху вниз (см. подробности в changelog у _ready() чуть выше):
#	1) ScreenApplyConfirmOverlay (окно "Применить/Отмена") — Esc = "Отмена",
#	   то есть буквально "выбор в сторону нет";
#	2) ScreenInfoPopupOverlay (окно-инфо, у него нет выбора Да/Нет) — Esc
#	   просто закрывает его, как и кнопка "Понял";
#	2.5) LoggerInfoPopupOverlay (2026-08-22, тот же принцип, что и у п.2 —
#	   окно-инфо "изменения применятся после перезапуска", без выбора Да/Нет);
#	3) иначе — если открыто само окно Настройки/Поддержка — Esc закрывает
#	   его тем же путём, что и крестик/клик мимо (если при этом есть
#	   несохранённый размер экрана — по цепочке откроется ScreenApplyConfirmOverlay,
#	   как и при обычном закрытии).
#	set_input_as_handled() после срабатывания — чтобы один Esc не сработал
#	сразу на нескольких уровнях за один кадр
#Форматы данных:
#	Входные:
#		vL_Event: InputEvent — событие от движка (_unhandled_input получает
#			ввод, который не был перехвачен ни одним Control'ом раньше)
func _unhandled_input(vL_Event: InputEvent) -> void:
	if not vL_Event.is_action_pressed("ui_cancel"):
		return
	if vSD_AllNodes_D.has("ScreenApplyConfirmOverlay") and vSD_AllNodes_D["ScreenApplyConfirmOverlay"]["Node"].visible:
		_fC_OnScreenApplyCancelPressed_Ch()
		get_viewport().set_input_as_handled()
		return
	if vSD_AllNodes_D.has("ScreenInfoPopupOverlay") and vSD_AllNodes_D["ScreenInfoPopupOverlay"]["Node"].visible:
		_fC_OnScreenInfoOkPressed_Ch()
		get_viewport().set_input_as_handled()
		return
	# 2026-08-22: третье info-окно (LoggerInfoPopupOverlay, "изменения применятся
	# после перезапуска") — та же логика, что и у ScreenInfoPopupOverlay выше:
	# у него нет выбора Да/Нет, Esc просто закрывает его, как и кнопка "Понял"
	if vSD_AllNodes_D.has("LoggerInfoPopupOverlay") and vSD_AllNodes_D["LoggerInfoPopupOverlay"]["Node"].visible:
		_fC_OnLoggerInfoOkPressed_Ch()
		get_viewport().set_input_as_handled()
		return
	if vLB_ModalOpen_Bv:
		_fC_CloseModal_Ch()
		get_viewport().set_input_as_handled()


#Функционал:
#	Строит конфиг словаря для узла-конфига (__Data_D/__Inspector_D/__Node_D,
#	опционально __Children_D) — сокращает повторяющийся код при описании экрана.
#	Путь до родителя и имя ноды НЕ указываются — их выставляет сам Class_UI
#	(fC_MassCreatingNode_0001/fC_SyncingNodesWithConfig_1111) по ключу словаря и
#	его месту в дереве (см. changelog)
#Форматы данных:
#	Входные:
#		vLS_Type_S: String — тип ноды Godot (ClassDB)
#		vLD_Inspector_D: Dictionary — свойства ноды (без "name" — его выставит Class_UI)
#		vLD_Signals_D: Dictionary — {имя_сигнала: Callable}, по умолчанию нет
#		vLD_Children_D: Dictionary — {ИмяРебёнка: конфиг_ребёнка (в этом же формате)},
#			по умолчанию нет — попадает в конфиг ноды под ключом __Children_D
#	Выходные:
#		Dictionary — готовый вложенный конфиг ноды для Class_UI
func _fC_NodeCfg(vLS_Type_S: String, vLD_Inspector_D: Dictionary, vLD_Signals_D: Dictionary = {}, vLD_Children_D: Dictionary = {}) -> Dictionary:
	var vLD_Result_D := {
		"__Data_D": {
			"__type_S": vLS_Type_S,
			"__Scene_size_V2i": vSV2_Scene_size_V2i,
		},
		"__Inspector_D": vLD_Inspector_D.duplicate(),
		"__Node_D": vLD_Signals_D,
	}
	if not vLD_Children_D.is_empty():
		vLD_Result_D["__Children_D"] = vLD_Children_D
	return vLD_Result_D


#Функционал:
#	Сливает базовые Inspector-свойства с доп. свойствами (например, якорями под
#	конкретную ориентацию), не изменяя переданные словари
func _fC_MergeInspector_Cr(vLD_Base_D: Dictionary, vLD_Extra_D: Dictionary) -> Dictionary:
	var vLD_Result_D: Dictionary = vLD_Base_D.duplicate()
	vLD_Result_D.merge(vLD_Extra_D)
	return vLD_Result_D


#Функционал:
#	Загружает настройки из res://Save/Settings.json и достраивает недостающие
#	ключи значениями по умолчанию — файл сейчас может быть пустым/содержать
#	null (Class_Json.fxG_LoadJson_Cr в этом случае честно вернёт {}, см. её
#	changelog), а после первого сохранения — только часть ключей, если формат
#	настроек расширится позже
#Форматы данных:
#	Входные: нет
#	Выходные:
#		Dictionary — {Locale, ScreenWidth, ScreenHeight, Fullscreen,
#			MusicVolume, InterfaceVolume}, все ключи гарантированно заполнены
#Принцип работы:
#	Locale, если не сохранён (или сохранён пустой строкой) — берём язык
#	системы через Class_Localization.fC_DetectSystemLocale_S (см. п.5 ТЗ:
#	"если ничего не указано в настройках — получать язык системы")
func _fC_LoadSettings_Cr() -> Dictionary:
	var vLD_Loaded_D: Dictionary = Class_Json.fxG_LoadJson_Cr(FileSettings)

	if not vLD_Loaded_D.has("Locale") or vLD_Loaded_D["Locale"] == "":
		vLD_Loaded_D["Locale"] = Class_Localization.fC_DetectSystemLocale_S()
	if not vLD_Loaded_D.has("ScreenWidth"):
		vLD_Loaded_D["ScreenWidth"] = int(vSV2_Scene_size_V2i.x)
	if not vLD_Loaded_D.has("ScreenHeight"):
		vLD_Loaded_D["ScreenHeight"] = int(vSV2_Scene_size_V2i.y)
	if not vLD_Loaded_D.has("Fullscreen"):
		vLD_Loaded_D["Fullscreen"] = false
	if not vLD_Loaded_D.has("MusicVolume"):
		vLD_Loaded_D["MusicVolume"] = 100
	if not vLD_Loaded_D.has("InterfaceVolume"):
		vLD_Loaded_D["InterfaceVolume"] = 100
	# 2026-08-19: окна-подтверждения при изменении размера экрана (см. changelog
	# про "окно применить/отмена") — по умолчанию ОБА показываются (true),
	# пользователь может отключить каждое отдельно через категорию "Подтверждения"
	if not vLD_Loaded_D.has("ShowScreenChangeInfoPopup"):
		vLD_Loaded_D["ShowScreenChangeInfoPopup"] = true
	if not vLD_Loaded_D.has("ShowScreenApplyConfirmPopup"):
		vLD_Loaded_D["ShowScreenApplyConfirmPopup"] = true
	# 2026-08-19: "защита от автоматического нажатия человеком" — категория
	# "Подтверждения" → "Автоматическое нажатие человеком" (ползунки), см.
	# _fC_OnScreenApplyButtonPressed_Ch. AutoClickProtectionSeconds — сколько
	# секунд после клика по "Применить" следующий клик считается "слишком
	# быстрым"; AutoClickDodgeLimit — сколько раз подряд кнопка успеет
	# "убежать" за один показ окна, прежде чем клики станут обычными
	if not vLD_Loaded_D.has("AutoClickProtectionSeconds"):
		vLD_Loaded_D["AutoClickProtectionSeconds"] = 0.5
	if not vLD_Loaded_D.has("AutoClickDodgeLimit"):
		vLD_Loaded_D["AutoClickDodgeLimit"] = 1
	# 2026-08-20: глобальный множитель размера шрифта — категория "Экран" →
	# ScreenFontScaleLineEdit (п.5 ТЗ: "давай в настройке экрана добавим размер
	# шрифта, сохраняем в настройки и влияет на всё"). 1.0 = обычный размер
	# (см. _fC_FontSize_I — домножается ПОВЕРХ уже существующего масштаба по
	# размеру окна, то есть это ДОПОЛНИТЕЛЬНЫЙ множитель, а не замена)
	if not vLD_Loaded_D.has("FontScale"):
		vLD_Loaded_D["FontScale"] = 1.0

	# 2026-08-22: категория "Логи и реплеи" — лимиты на хранение логов
	# программы и реплеев (6 лимитов: количество/время/объём памяти — на
	# каждый и Enabled-флаг для галочки-квадрата слева, и само число для поля
	# ввода справа). ⚠️ Здесь заводятся ТОЛЬКО настройки и их UI — реальную
	# ротацию/удаление старых логов и реплеев по этим лимитам делает (или
	# будет делать) сам Class_Logger/будущая система реплеев, этот экран их
	# не трогает и не читает, просто хранит значения (тот же принцип, что и
	# у AutoClickProtectionSeconds/AutoClickDodgeLimit — вычитывает их уже
	# _fC_OnScreenApplyButtonPressed_Ch, а не этот файл)
