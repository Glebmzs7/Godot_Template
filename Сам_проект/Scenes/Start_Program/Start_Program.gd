#Функционал:
#	Перекрашивает/переподписывает кнопку-переключатель в категории
#	"Подтверждения" под текущее состояние — переиспользует уже готовую
#	цветовую палитру статусов чек-листа (vGD_StatusColors_D["passed"/"failed"]),
#	чтобы не заводить отдельные "магические" цвета just for this
#Форматы данных:
#	Входные:
#		vLS_NodeKey_S: String — ключ ноды-кнопки в vSD_AllNodes_D
#		vLB_Enabled_Bv: bool — true = окно-уведомление показывается (зелёная),
#			false = скрыто (красная)
#Принцип работы:
#	⚠️ 2026-08-23, найден и починен баг ("окно про логи/реплеи вылезает само,
#	хотя в настройки не заходил"): раньше здесь стояло `vL_Button.button_pressed
#	= vLB_Enabled_Bv` — обычное присваивание свойства toggle-кнопки в Godot
#	САМО испускает сигнал "toggled", если значение реально меняется (см.
#	BaseButton.set_pressed в движке). Эта функция вызывается и как "чистая
#	визуальная синхронизация" из _fC_ApplySettingsToUI_Ch при первой сборке
#	экрана (переносит РАНЬШЕ СОХРАНЁННОЕ значение из vXD_Settings_D на кнопку,
#	созданную с др. дефолтом в статическом конфиге) — если сохранённое
#	значение отличается от дефолта в конфиге, присваивание считается "реальным
#	изменением", Godot испускает "toggled", а он подключён к
#	_fC_OnConfirmationToggle_Ch/_fC_OnLoggerLimitToggled_Ch (см. ниже), которые
#	ПОВТОРНО сохраняют настройки и (для логов/реплеев) показывают info-окно —
#	то есть окно вылезало на КАЖДОМ старте программы, если хоть раз до этого
#	один из переключателей был сохранён не-дефолтным значением, даже если
#	пользователь в текущем запуске в настройки не заходил вообще.
#	set_pressed_no_signal — тот же метод BaseButton, что и предназначен именно
#	для программной синхронизации состояния БЕЗ повторного срабатывания
#	сигнала; для реального клика пользователя ничего не меняется (сигнал
#	"toggled" в этом случае испускает сам движок ДО вызова
#	_fC_OnConfirmationToggle_Ch/_fC_OnLoggerLimitToggled_Ch, эта функция там
#	только докрашивает визуал уже правильного состояния)
func _fC_UpdateConfirmToggleVisual_Ch(vLS_NodeKey_S: String, vLB_Enabled_Bv: bool) -> void:
	if not vSD_AllNodes_D.has(vLS_NodeKey_S):
		return
	var vL_Button: Button = vSD_AllNodes_D[vLS_NodeKey_S]["Node"]
	vL_Button.set_pressed_no_signal(vLB_Enabled_Bv)
	vL_Button.text = "CONFIRM_TOGGLE_ON" if vLB_Enabled_Bv else "CONFIRM_TOGGLE_OFF"
	vL_Button.modulate = vGD_StatusColors_D["passed"] if vLB_Enabled_Bv else vGD_StatusColors_D["failed"]


