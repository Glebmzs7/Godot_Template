#	generic-схема через .bind(), что и у _fC_OnConfirmationToggle_Ch/
#	_fC_OnSoundSliderChanged_Ch — один обработчик на все 6 галочек, а не 6
#	отдельных функций
#Форматы данных:
#	Входные:
#		vLB_Pressed: bool — новое состояние галочки (сигнал toggled)
#		vLS_SettingsKey_S: String — ключ *Enabled в vXD_Settings_D, привязан
#			через .bind() (см. vGD_LoggerRows_A)
#		vLS_NodeKey_S: String — ключ ноды-галочки в vSD_AllNodes_D для
#			перекраски, привязан через .bind()
func _fC_OnLoggerLimitToggled_Ch(vLB_Pressed: bool, vLS_SettingsKey_S: String, vLS_NodeKey_S: String) -> void:
