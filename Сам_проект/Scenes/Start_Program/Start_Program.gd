#Функционал:
#	2026-08-24: общая валидация формы добавления аккаунта — вынесена из
#	_fC_OnAccountAddSavePressed_Ch, чтобы её могла переиспользовать новая
#	_fC_OnAccountAddRegisterPressed_Ch ("Зарегистрироваться", см. ниже) — те
#	же 3 поля, те же правила (не пусто, ник не зарезервирован, ник ещё не занят)
#Форматы данных:
#	Выходные: Dictionary — {"Ok": bool, "Nick": String, "Id": String, "Password": String, "Error": String}
func _fL_ReadAndValidateAccountAddForm_Cr() -> Dictionary:
	if not (vSD_AllNodes_D.has("AccountPickerAddNickLineEdit") and vSD_AllNodes_D.has("AccountPickerAddIdLineEdit") and vSD_AllNodes_D.has("AccountPickerAddPasswordLineEdit")):
		push_warning("⚠️ _fL_ReadAndValidateAccountAddForm_Cr: поля формы не найдены в реестре")
		return {"Ok": false, "Nick": "", "Id": "", "Password": "", "Error": "Поля формы не найдены."}

	var vLS_Nick_S: String = String(vSD_AllNodes_D["AccountPickerAddNickLineEdit"]["Node"].text).strip_edges()
	var vLS_Id_S: String = String(vSD_AllNodes_D["AccountPickerAddIdLineEdit"]["Node"].text).strip_edges()
	var vLS_Password_S: String = String(vSD_AllNodes_D["AccountPickerAddPasswordLineEdit"]["Node"].text)

	if vLS_Nick_S.is_empty() or vLS_Id_S.is_empty() or vLS_Password_S.is_empty():
		return {"Ok": false, "Nick": vLS_Nick_S, "Id": vLS_Id_S, "Password": vLS_Password_S, "Error": "Заполните ник, ID и пароль."}
	if vLS_Nick_S == ACCOUNT_TECHNICAL_SERVER_VALUE:
		return {"Ok": false, "Nick": vLS_Nick_S, "Id": vLS_Id_S, "Password": vLS_Password_S, "Error": "Имя \"%s\" зарезервировано, выберите другой ник." % ACCOUNT_TECHNICAL_SERVER_VALUE}
	if vLD_AccountsList_D.has(vLS_Nick_S):
		return {"Ok": false, "Nick": vLS_Nick_S, "Id": vLS_Id_S, "Password": vLS_Password_S, "Error": "Аккаунт с ником \"%s\" уже есть." % vLS_Nick_S}

	return {"Ok": true, "Nick": vLS_Nick_S, "Id": vLS_Id_S, "Password": vLS_Password_S, "Error": ""}


#Функционал:
#	2026-08-23: обработчик кнопки "Применить" формы добавления аккаунта —
#	читает Ник/ID/Пароль из полей, проверяет и, если всё в порядке, добавляет
#	аккаунт в vLD_AccountsList_D, сохраняет файл (_fC_SaveAccountsList_Ch) и
#	пересобирает экран (_fC_RefreshScreenAfterDataChange_Ch), чтобы новая
#	кнопка появилась СРАЗУ, без перезапуска программы
#Принцип работы:
#	⚠️ 2026-08-23, правка после переезда окна внутрь InfoBoxPanel: видимость
#	AccountPickerAddForm/AccountPickerScroll/AccountPickerSection выставляем
#	ПОСЛЕ пересборки, а не до. Раньше (когда список кнопок был отдельной
#	веткой без общего родителя с формой) это было не важно, но теперь и
#	список, и форма лежат ВНУТРИ AccountPickerSection — а fC_SyncingNodesWithConfig_1111
#	решает, пересоздавать ли ноду, по тому, отличается ли ЕЁ ПОДДЕРЕВО целиком
#	(старый/новый конфиг сравниваются рекурсивно, см. f__SyncCallback_CreateOrUpdate
#	в Class_UI.gd) — раз список кнопок внутри AccountPickerSection изменился,
#	САМА AccountPickerSection (и всё по цепочке вверх — InfoBoxVBox, InfoBoxPanel)
#	тоже считается "изменившейся" и пересоздаётся ЗАНОВО из статического
#	конфига (там "visible": false у AccountPickerSection) — то есть если
#	выставить видимость ДО пересборки, пересборка её тут же сотрёт, и окно
#	выбора аккаунта попросту исчезнет с экрана после сохранения. Поэтому
#	видимость возвращаем уже ПОСЛЕ, когда все ноды точно на месте
#Форматы данных:
#	Входные: нет
#	Выходные: нет
func _fC_OnAccountAddSavePressed_Ch() -> void:
	var vLD_Form_D := _fL_ReadAndValidateAccountAddForm_Cr()
	if not bool(vLD_Form_D.get("Ok", false)):
		_fC_ShowAccountPickerMessage_Ch(String(vLD_Form_D.get("Error", "")))
		return
	var vLS_Nick_S: String = vLD_Form_D["Nick"]
	var vLS_Id_S: String = vLD_Form_D["Id"]
	var vLS_Password_S: String = vLD_Form_D["Password"]

	vLD_AccountsList_D[vLS_Nick_S] = {"ID": vLS_Id_S, "Password": vLS_Password_S}
	_fC_SaveAccountsList_Ch(vLD_AccountsList_D)
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "AccountPicker: добавлен аккаунт " + vLS_Nick_S, [], null)

	_fC_ClearAccountAddForm_Ch()
	_fC_RefreshScreenAfterDataChange_Ch()

	# Пересборка выше могла пересоздать AccountPickerSection и всё внутри нею
	# (см. Принцип работы) — возвращаем нужное состояние видимости УЖЕ ПОСЛЕ,
	# работая с (возможно, уже новыми) нодами через vSD_AllNodes_D
	if vSD_AllNodes_D.has("AccountPickerSection"):
		vSD_AllNodes_D["AccountPickerSection"]["Node"].visible = true
	if vSD_AllNodes_D.has("AccountPickerAddForm"):
		vSD_AllNodes_D["AccountPickerAddForm"]["Node"].visible = false
	if vSD_AllNodes_D.has("AccountPickerScroll"):
		vSD_AllNodes_D["AccountPickerScroll"]["Node"].visible = true
	if vSD_AllNodes_D.has("InfoBoxLabel"):
		vSD_AllNodes_D["InfoBoxLabel"]["Node"].visible = false
	_fC_ShowAccountPickerMessage_Ch("Аккаунт \"%s\" добавлен." % vLS_Nick_S)


#Функционал:
#	2026-08-24 (по просьбе пользователя "добавим... регистрацию для входа"):
#	обработчик кнопки "Зарегистрироваться" формы добавления аккаунта. В
#	отличие от "Применить" (только локальная запись — сервер вообще не в
#	курсе этого логина/пароля заранее), эта кнопка сразу создаёт УЧЁТНУЮ
#	ЗАПИСЬ НА СЕРВЕРЕ: сохраняет аккаунт локально (тот же ID/пароль нужен
#	дальше для обычного входа — см. _fC_StartClientConnection_Ch), затем
#	запускает подключение; как только Class_InternetClient дойдёт до
#	AUTHENTICATING, _process (см. её ветку выше) пошлёт Op "Register" вместо
#	обычного AuthRequest — ответ обрабатывает _fC_HandleRegisterResult_Ch.
#	⚠️ Пароль при регистрации идёт на сервер ОДНИМ ПАКЕТОМ В ОТКРЫТОМ ВИДЕ
#	(в отличие от обычного входа — там challenge-response, пароль по сети не
#	передаётся, см. Class_InternetClient.fC_SendCredentials_Ch) — для этого
#	пути обязателен WSS (см. Class_InternetServer.fC_ConfigureTls_Bv), иначе
#	пароль виден по сети как есть (см. changelog Class_InternetClient.fC_RegisterAccount_Ch)
#Форматы данных:
#	Входные: нет
#	Выходные: нет
func _fC_OnAccountAddRegisterPressed_Ch() -> void:
	var vLD_Form_D := _fL_ReadAndValidateAccountAddForm_Cr()
	if not bool(vLD_Form_D.get("Ok", false)):
		_fC_ShowAccountPickerMessage_Ch(String(vLD_Form_D.get("Error", "")))
		return
	var vLS_Nick_S: String = vLD_Form_D["Nick"]
	var vLS_Id_S: String = vLD_Form_D["Id"]
	var vLS_Password_S: String = vLD_Form_D["Password"]

	vLD_AccountsList_D[vLS_Nick_S] = {"ID": vLS_Id_S, "Password": vLS_Password_S}
	_fC_SaveAccountsList_Ch(vLD_AccountsList_D)
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "AccountPicker: регистрация нового аккаунта на сервере " + vLS_Nick_S, [], null)

	_fC_ClearAccountAddForm_Ch()
	vLS_SelectedAccount_S = vLS_Nick_S
	_vLB_PendingRegistration_Bv = true

	# Пересборка (см. подробный разбор в _fC_OnAccountAddSavePressed_Ch выше) —
	# новый аккаунт должен появиться в списке кнопок НА СЛУЧАЙ, если
	# регистрация на сервере провалится и мы вернём окно выбора аккаунта назад
	# (см. _fC_HandleRegisterResult_Ch); пересборка попутно возвращает нужные
	# нам умолчания видимости (AccountPickerSection скрыт, InfoBoxLabel
	# виден) — лишние ручные fixup'ы здесь не нужны
	_fC_RefreshScreenAfterDataChange_Ch()

	fC_SetCheckStatus_Ch("Server", "checking")
	_fC_StartClientConnection_Ch()


#Функционал:
