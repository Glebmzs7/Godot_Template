#	и возвращает обычный статусный текст (InfoBoxLabel) на место
#Форматы данных:
#	Входные: vLS_Account_S: String — выбранный аккаунт или ACCOUNT_TECHNICAL_SERVER_VALUE
#	Выходные: нет
func _fC_OnAccountOptionPressed_Ch(vLS_Account_S: String) -> void:
	vLS_SelectedAccount_S = vLS_Account_S
	if vSD_AllNodes_D.has("AccountPickerSection"):
		vSD_AllNodes_D["AccountPickerSection"]["Node"].visible = false
	if vSD_AllNodes_D.has("InfoBoxLabel"):
		vSD_AllNodes_D["InfoBoxLabel"]["Node"].visible = true
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "AccountPicker: выбран " + vLS_Account_S, [], null)
	_fC_RunServerCheck_Ch()


#Функционал:
#	2026-08-23 (правка, была заглушка): продолжение проверки "Server" после
#	выбора аккаунта. Роль "Server" — сама сцена Start_Program для неё не
#	место: переключаемся на res://Scenes/StartServer/StartServer.tscn, там (см. её changelog)
#	поднимается Class_InternetServer. Реальный аккаунт — остаётся здесь и
#	запускает настоящее подключение (_fC_StartClientConnection_Ch)
func _fC_RunServerCheck_Ch() -> void:
	if vLS_SelectedAccount_S == ACCOUNT_TECHNICAL_SERVER_VALUE:
		Class_UI.fxC_SwitchingScene_0000("res://Scenes/StartServer/StartServer.tscn")
		return
	_fC_StartClientConnection_Ch()


#Функционал:
#	2026-08-23: запускает настоящее подключение к серверу через
#	Class_InternetClient. add_child ОБЯЗАТЕЛЕН (см. changelog Class_InternetClient.gd
#	— это Node с переопределённым _process, без добавления в дерево сцены
#	опрос сокета просто не будет вызываться), делаем это только один раз
#	(_vLB_ClientConnectionStarted_Bv) — тогда же подключаем AppOpReceived_S
#	(см. changelog Class_Internet.gd) на _fC_OnClientAppOpReceived_Ch — это
#	точка входа для ответов "CheckUpdate"/"CheckFiles" (фаза 2). vGS_UserID_S
#	берём из ID выбранного аккаунта (см. vLD_AccountsList_D) — это то, что
#	сервер увидит как "кто подключился". Дальше опрос состояния подключения —
#	в _process ниже
#Форматы данных:
#	Входные: нет
#	Выходные: нет
func _fC_StartClientConnection_Ch() -> void:
	var vLD_Account_D: Dictionary = vLD_AccountsList_D.get(vLS_SelectedAccount_S, {})
	Class_InternetClient.vGS_UserID_S = String(vLD_Account_D.get("ID", vLS_SelectedAccount_S))

	if not _vLB_ClientConnectionStarted_Bv:
		add_child(Class_InternetClient)
		Class_InternetClient.AppOpReceived_S.connect(_fC_OnClientAppOpReceived_Ch)
		_vLB_ClientConnectionStarted_Bv = true

	_vLB_ServerCheckResolved_Bv = false
	_vLB_CredentialsSent_Bv = false
	# 2026-08-24: НЕ сбрасываем _vLB_PendingRegistration_Bv здесь — она
	# выставляется ДО вызова этой функции (см. _fC_OnAccountAddRegisterPressed_Ch)
	# и должна пережить повторный вызов этой же функции через "Повторить
	# подключение" (InfoBoxRetryButton), если регистрация ещё не разрешилась —
	# сбрасывает её только _fC_HandleRegisterResult_Ch
	_vLB_RegistrationSent_Bv = false
	_vLB_AutonomousModeOffered_Bv = false
	_vLF_ServerConnectAttemptStartedAtMsec_F = Time.get_ticks_msec()

	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_StartClientConnection_Ch: подключаемся", [SERVER_ADDRESS_S, Class_InternetClient.vGS_UserID_S], null)

	var vLB_Started_Bv: bool = Class_InternetClient.fxG_EstablishingConnection_CrTr(SERVER_ADDRESS_S)
	if not vLB_Started_Bv:
		fC_SetCheckStatus_Ch("Server", "failed", "Не удалось начать подключение к серверу.")
		_fC_OfferAutonomousMode_Ch()
		return

	# 2026-08-24: показываем таймер только если попытка реально запустилась
	# (см. _fC_UpdateConnectingTimerLabel_Ch — обновляет текст каждый кадр,
	# здесь только видимость + начальный текст "0 сек", чтобы не мигало
	# пустой подписью один кадр до первого _process)
	if vSD_AllNodes_D.has("InfoBoxConnectingLabel"):
		vSD_AllNodes_D["InfoBoxConnectingLabel"]["Node"].visible = true
		vSD_AllNodes_D["InfoBoxConnectingLabel"]["Node"].text = "Подключение к серверу… 0 сек"


#Функционал:
#	2026-08-23: отправляет сохранённые в vLD_AccountsList_D логин/пароль
#	выбранного аккаунта на Challenge (вызывается из _process, когда
#	Class_InternetClient переходит в ConnectionState.AUTHENTICATING — то есть
#	сервер потребовал авторизацию). Один раз за попытку подключения
#	(_vLB_CredentialsSent_Bv) — AUTHENTICATING держится, пока не придёт
#	AuthSuccess/AuthFailed, повторные вызовы не нужны. ⚠️ Не проверялось живьём
#	— по умолчанию у test.gd сервер поднимается с RequireAuth=false, этот путь
#	пока не задействуется в реальном тестировании (см. её changelog)
func _fC_SendStoredCredentials_Ch() -> void:
	if _vLB_CredentialsSent_Bv:
		return
	_vLB_CredentialsSent_Bv = true
	var vLD_Account_D: Dictionary = vLD_AccountsList_D.get(vLS_SelectedAccount_S, {})
	Class_InternetClient.fC_SendCredentials_Ch(String(vLD_Account_D.get("ID", vLS_SelectedAccount_S)), String(vLD_Account_D.get("Password", "")))


#Функционал:
#	2026-08-24 (по просьбе пользователя "добавим... регистрацию для входа"):
#	вызывается из _process ВМЕСТО _fC_SendStoredCredentials_Ch, когда текущая
#	попытка подключения начата через "Зарегистрироваться"
#	(_vLB_PendingRegistration_Bv, см. _fC_OnAccountAddRegisterPressed_Ch) — шлёт
#	Op "Register" с тем же ID/паролем, что только что сохранены в
#	vLD_AccountsList_D. Один раз за попытку (_vLB_RegistrationSent_Bv, тот же
#	приём, что и у _vLB_CredentialsSent_Bv). Ответ ("RegisterResult") придёт в
#	_fC_OnClientAppOpReceived_Ch → _fC_HandleRegisterResult_Ch
func _fC_SendRegistrationRequest_Ch() -> void:
	if _vLB_RegistrationSent_Bv:
		return
	_vLB_RegistrationSent_Bv = true
	var vLD_Account_D: Dictionary = vLD_AccountsList_D.get(vLS_SelectedAccount_S, {})
	Class_InternetClient.fC_RegisterAccount_Ch(String(vLD_Account_D.get("ID", vLS_SelectedAccount_S)), String(vLD_Account_D.get("Password", "")))


#Функционал:
#	2026-08-23: вызывается из _process, когда Class_InternetClient впервые
#	доходит до ConnectionState.CONNECTED — отмечает "Server" пройденным и
#	(2026-08-23, фаза 2) запускает настоящие "Update"/"ThirdPartyFiles" —
#	оба переходят в "checking" (см. vGD_StatusSymbols_D — есть отдельный
#	статус "идёт проверка", отличный от "waiting"/"passed"/"failed") и ждут
#	ответа сервера через _fC_OnClientAppOpReceived_Ch
func _fC_OnServerConnected_Ch() -> void:
	if _vLB_ServerCheckResolved_Bv:
		return
	_vLB_ServerCheckResolved_Bv = true
	if vSD_AllNodes_D.has("InfoBoxAutonomousButton"):
		vSD_AllNodes_D["InfoBoxAutonomousButton"]["Node"].visible = false
	# 2026-08-24 (найден и починен баг "сервер подключился позже, чем должен
	# был — это ломает интерфейс"): раньше здесь пряталась только
	# InfoBoxAutonomousButton, а InfoBoxRetryButton — нет. Если подключение
	# затягивалось дольше SERVER_CONNECT_TIMEOUT_SECONDS_F (обе кнопки уже
	# показаны, см. _fC_OfferAutonomousMode_Ch), а потом ВСЁ ЖЕ проходило само
	# (см. _process — опрашивает состояние каждый кадр, даже после показа
	# кнопок), эта функция корректно прятала "Продолжить без сервера" и вела
	# чек-лист дальше — но "Повторить подключение" оставалась висеть и
	# кликабельной. Нажатие на неё после того, как сервер уже подключён,
	# заново дёргало _fC_StartClientConnection_Ch (см. её changelog про
	# "безопасно вызывать снова") — это откатывало "Server" на "checking" и,
	# при последующем повторном срабатывании этой же функции, сбрасывало
	# "Update"/"ThirdPartyFiles" обратно на "checking" тоже, даже если они уже
	# были "passed" — визуально "меняются галочки на всех трёх". Теперь обе
	# кнопки прячутся здесь разом, как только соединение реально установлено
	if vSD_AllNodes_D.has("InfoBoxRetryButton"):
		vSD_AllNodes_D["InfoBoxRetryButton"]["Node"].visible = false
	# 2026-08-24: таймер "Подключение к серверу…" (см. InfoBoxConnectingLabel)
	# свою роль отыграл — соединение установлено, дальше статус виден по
	# самому чек-листу
	if vSD_AllNodes_D.has("InfoBoxConnectingLabel"):
		vSD_AllNodes_D["InfoBoxConnectingLabel"]["Node"].visible = false
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnServerConnected_Ch: подключено", [], null)
	fC_SetCheckStatus_Ch("Server", "passed")
	fC_SetCheckStatus_Ch("Update", "checking")
	fC_SetCheckStatus_Ch("ThirdPartyFiles", "checking")
	_fC_SendUpdateCheckRequest_Ch()
	_fC_SendFileIntegrityCheckRequest_Ch()


#Функционал:
#	2026-08-23 (фаза 2): отправляет серверу Op "CheckUpdate" со своей версией
#	(APP_VERSION_S) — ответ ("CheckUpdateResult") придёт в
#	_fC_OnClientAppOpReceived_Ch → _fC_HandleUpdateCheckResult_Ch (см.
#	AppOpReceived_S, changelog Class_Internet.gd)
func _fC_SendUpdateCheckRequest_Ch() -> void:
	Class_InternetClient.fC_SendingMessage_Cr("CheckUpdate", {"Version": APP_VERSION_S}, {}, Class_InternetClient.SERVER_RECIPIENT_ID, true)


#Функционал:
#	2026-08-23 (фаза 2): строит отпечатки ВСЕХ проверяемых файлов (см.
#	Class_FileIntegrity.fC_ListCheckableFiles_Cr — "все не индивидуальные",
#	см. ответ на уточняющий вопрос про охват в
#	План проекта/Class_Internet.md) и отправляет Op "CheckFiles" — ответ
#	придёт в _fC_HandleFileIntegrityResult_Ch
func _fC_SendFileIntegrityCheckRequest_Ch() -> void:
	var vLA_Fingerprints_A := []
	for elLS_Path in Class_FileIntegrity.fC_ListCheckableFiles_Cr():
		var vLD_Fingerprint_D := Class_FileIntegrity.fC_BuildFingerprint_Cr(elLS_Path)
		if not vLD_Fingerprint_D.is_empty():
			vLA_Fingerprints_A.append(vLD_Fingerprint_D)
	Class_InternetClient.fC_SendingMessage_Cr("CheckFiles", {"Files": vLA_Fingerprints_A}, {}, Class_InternetClient.SERVER_RECIPIENT_ID, true)


#Функционал:
#	2026-08-23 (фаза 2): точка входа для всех прикладных ответов от сервера
#	(см. AppOpReceived_S, подключён в _fC_StartClientConnection_Ch) —
#	разбирает по Op ИСХОДНОГО запроса (см. её сигнатуру в Class_Internet.gd)
#Форматы данных:
#	Входные: см. Class_Internet.AppOpReceived_S
func _fC_OnClientAppOpReceived_Ch(vLS_Op_S: String, vLD_Envelope_D: Dictionary, _vLF_ReceivedNowAt_F: float, _vLS_ReplyRoutingKey_S: String) -> void:
	match vLS_Op_S:
		"CheckUpdate":
			_fC_HandleUpdateCheckResult_Ch(vLD_Envelope_D)
		"CheckFiles":
			_fC_HandleFileIntegrityResult_Ch(vLD_Envelope_D)
		"Register":
			_fC_HandleRegisterResult_Ch(vLD_Envelope_D)
		_:
			push_warning("⚠️ Start_Program.gd: неизвестная прикладная операция от сервера Op=%s" % vLS_Op_S)


#Функционал:
#	2026-08-23 (фаза 2): разбирает ответ сервера на "CheckUpdate" — при
#	совпадении версий "Update" отмечается пройденным, иначе — крестик с
#	сообщением о доступном обновлении (см. ответ на уточняющий вопрос в
#	План проекта/Class_Internet.md — "появляется несовпадение версии и
#	предложение обновления"). 2026-08-24 (правка): при провале теперь ТОЖЕ
#	предлагается автономный режим (см. _fC_ShowAutonomousModeButton_Ch) —
#	раньше при провале именно этой (или следующей) проверки чек-лист просто
#	зависал без какого-либо выхода
func _fC_HandleUpdateCheckResult_Ch(vLD_ReplyEnvelope_D: Dictionary) -> void:
	var vLD_Messages_D: Dictionary = vLD_ReplyEnvelope_D.get("Messages", {})
	if bool(vLD_Messages_D.get("UpToDate", false)):
		fC_SetCheckStatus_Ch("Update", "passed")
	else:
		var vLS_Latest_S: String = String(vLD_Messages_D.get("LatestVersion", "?"))
		fC_SetCheckStatus_Ch("Update", "failed", "Доступна новая версия %s (у вас %s) — рекомендуем обновиться." % [vLS_Latest_S, APP_VERSION_S])
		_fC_ShowAutonomousModeButton_Ch()


#Функционал:
#	2026-08-23 (фаза 2): разбирает ответ сервера на "CheckFiles" —
#	"ThirdPartyFiles" пройден, только если сервер подтвердил совпадение ПО
#	ВСЕМ присланным файлам (размер + случайный байт) и не нашёл лишних.
#	2026-08-24 (правка): при провале тоже предлагается автономный режим, см.
#	changelog _fC_HandleUpdateCheckResult_Ch выше — тот же принцип.
#	2026-08-24 (ревью интернет-кода): сервер теперь умеет находить ещё и
#	УДАЛЁННЫЕ файлы (см. changelog test.gd::_fC_HandleCheckFilesRequest_Ch —
#	новое поле "Missing" в ответе), сообщение на экране обновлено под это
func _fC_HandleFileIntegrityResult_Ch(vLD_ReplyEnvelope_D: Dictionary) -> void:
	var vLD_Messages_D: Dictionary = vLD_ReplyEnvelope_D.get("Messages", {})
	if bool(vLD_Messages_D.get("Ok", false)):
		fC_SetCheckStatus_Ch("ThirdPartyFiles", "passed")
	else:
		fC_SetCheckStatus_Ch("ThirdPartyFiles", "failed", "Обнаружены изменённые, посторонние или отсутствующие файлы.")
		_fC_ShowAutonomousModeButton_Ch()


#Функционал:
#	2026-08-24 (по просьбе пользователя "добавим... регистрацию для входа"):
#	разбирает ответ сервера на "Register" (см.
#	_fC_SendRegistrationRequest_Ch/Class_InternetServer._fL_OnRegisterRequest_Ch).
#	Успех: только сбрасывает _vLB_PendingRegistration_Bv — Class_InternetClient
#	остаётся в AUTHENTICATING (Register не меняет её состояние, это тот же
#	хендшейк, что и обычный вход), на СЛЕДУЮЩЕМ кадре _process уже пойдёт по
#	обычной ветке (_fC_SendStoredCredentials_Ch) с тем же ID/паролем — то есть
#	сразу логинимся под только что созданным аккаунтом, без дополнительного
#	действия пользователя. Провал: возвращаем окно выбора аккаунта с текстом
#	ошибки сервера (короткий пароль/занятый логин/регистрация выключена на
#	сервере — см. варианты в _fL_OnRegisterRequest_Ch) и НЕ пытаемся логиниться
#	дальше этой попыткой; соединение специально не закрывается — если
#	пользователь не нажмёт форму заново, через SERVER_CONNECT_TIMEOUT_SECONDS_F
#	сработает обычный таймаут (см. _process/_fC_OfferAutonomousMode_Ch)
#Форматы данных:
#	Входные: vLD_ReplyEnvelope_D: Dictionary — см. AppOpReceived_S
#	Выходные: нет
func _fC_HandleRegisterResult_Ch(vLD_ReplyEnvelope_D: Dictionary) -> void:
	var vLD_Messages_D: Dictionary = vLD_ReplyEnvelope_D.get("Messages", {})
	_vLB_PendingRegistration_Bv = false

	if bool(vLD_Messages_D.get("Ok", false)):
		if vLS_StreamId != "":
			Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_HandleRegisterResult_Ch: аккаунт создан на сервере, входим", [vLS_SelectedAccount_S], null)
		return

	var vLS_Error_S: String = String(vLD_Messages_D.get("Error", "Не удалось зарегистрироваться."))
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_HandleRegisterResult_Ch: отказ сервера", [vLS_Error_S], null)

	if vSD_AllNodes_D.has("InfoBoxConnectingLabel"):
		vSD_AllNodes_D["InfoBoxConnectingLabel"]["Node"].visible = false
	if vSD_AllNodes_D.has("InfoBoxLabel"):
		vSD_AllNodes_D["InfoBoxLabel"]["Node"].visible = false
	if vSD_AllNodes_D.has("AccountPickerSection"):
		vSD_AllNodes_D["AccountPickerSection"]["Node"].visible = true
	if vSD_AllNodes_D.has("AccountPickerAddForm"):
		vSD_AllNodes_D["AccountPickerAddForm"]["Node"].visible = true
	if vSD_AllNodes_D.has("AccountPickerScroll"):
		vSD_AllNodes_D["AccountPickerScroll"]["Node"].visible = false
	_fC_ShowAccountPickerMessage_Ch(vLS_Error_S)


#Функционал:
#	2026-08-24: показывает InfoBoxAutonomousButton — вынесена отдельно из
#	_fC_OfferAutonomousMode_Ch, потому что теперь её вызывают ТРИ разных места
#	(провал Server/Update/ThirdPartyFiles — любая из трёх последних проверок
#	чек-листа), а не только провал самого подключения
func _fC_ShowAutonomousModeButton_Ch() -> void:
	if vSD_AllNodes_D.has("InfoBoxAutonomousButton"):
		vSD_AllNodes_D["InfoBoxAutonomousButton"]["Node"].visible = true


#Функционал:
#	2026-08-23: подключение затянулось дольше SERVER_CONNECT_TIMEOUT_SECONDS_F
#	— показывает кнопку "Продолжить без сервера" (см. _fC_ShowAutonomousModeButton_Ch
#	выше). Class_InternetClient продолжает пытаться переподключиться сам по
#	себе (fC_Reconnect_Ch) — если получится ПОСЛЕ показа этой кнопки, но ДО
#	того, как пользователь её нажмёт, _process всё равно поймает
#	ConnectionState.CONNECTED и вызовет _fC_OnServerConnected_Ch как обычно
#	(см. её начало — сама скрывает эту кнопку). 2026-08-24 (обратная связь
#	"если провалилось первое из трёх [Server] — предлагаем ЕЩЁ повторить
#	подключение"): теперь рядом появляется ещё и InfoBoxRetryButton — ТОЛЬКО
#	здесь, при провале именно "Server" (см. _fC_OnRetryConnectionPressed_Ch) —
#	Update/ThirdPartyFiles эта кнопка не предлагают, повтор подключения их
#	не касается
#Форматы данных:
#	Входные: нет
#	Выходные: нет
func _fC_OfferAutonomousMode_Ch() -> void:
	_vLB_AutonomousModeOffered_Bv = true
	fC_SetCheckStatus_Ch("Server", "failed", "Не удалось подключиться к серверу.")
	_fC_ShowAutonomousModeButton_Ch()
	if vSD_AllNodes_D.has("InfoBoxRetryButton"):
		vSD_AllNodes_D["InfoBoxRetryButton"]["Node"].visible = true
	# 2026-08-24: таймер "Подключение к серверу…" (InfoBoxConnectingLabel)
	# прячется здесь же — попытка разрешилась (неудачей), дальше на его месте
	# кнопки "Повторить подключение"/"Продолжить без сервера"
	if vSD_AllNodes_D.has("InfoBoxConnectingLabel"):
		vSD_AllNodes_D["InfoBoxConnectingLabel"]["Node"].visible = false


#Функционал:
#	2026-08-24: нажатие "Повторить подключение" — только для провала "Server"
#	(см. её changelog в _fC_OfferAutonomousMode_Ch выше). Прячет обе кнопки,
#	переводит "Server" обратно в "checking" и запускает новую попытку через
#	уже существующий _fC_StartClientConnection_Ch (она сама сбрасывает флаги
#	_vLB_ServerCheckResolved_Bv/_vLB_CredentialsSent_Bv/_vLB_AutonomousModeOffered_Bv
#	и таймер таймаута — работает как первая попытка, просто вызванная повторно;
#	Class_InternetClient.fxG_EstablishingConnection_CrTr безопасно вызывать
#	снова — заново создаёт WebSocketPeer, старой попытке ничего не мешает).
#	2026-08-24 (доп. защита от бага "сервер подключился позже — ломает
#	интерфейс", см. changelog _fC_OnServerConnected_Ch): сама кнопка теперь
#	прячется, как только соединение реально устанавливается, так что в
#	обычных условиях нажать её ПОСЛЕ подключения уже нельзя — но на случай,
#	если это всё же произойдёт (например, клик и подтверждение подключения
#	случились в один и тот же кадр), добавлена защитная проверка ниже: если
#	Class_InternetClient УЖЕ в состоянии CONNECTED, повторное подключение не
#	запускается вообще — только прячутся кнопки, без сброса проверок
#Форматы данных:
#	Входные: нет
#	Выходные: нет
func _fC_OnRetryConnectionPressed_Ch() -> void:
	if vSD_AllNodes_D.has("InfoBoxRetryButton"):
		vSD_AllNodes_D["InfoBoxRetryButton"]["Node"].visible = false
	if vSD_AllNodes_D.has("InfoBoxAutonomousButton"):
		vSD_AllNodes_D["InfoBoxAutonomousButton"]["Node"].visible = false
	if Class_InternetClient.vGE_State == Class_InternetClient.ConnectionState.CONNECTED:
		if vLS_StreamId != "":
			Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnRetryConnectionPressed_Ch: уже подключены, повтор не нужен", [], null)
		return
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnRetryConnectionPressed_Ch: повторная попытка подключения", [], null)
	fC_SetCheckStatus_Ch("Server", "checking")
	_fC_StartClientConnection_Ch()


#Функционал:
#	2026-08-23: нажатие "Продолжить без сервера" — пользователь осознанно
#	продолжает без реального сервера. 2026-08-23 (правка, обратная связь "если
#	подключаемся без сети — то все крестики"): раньше "Server"/"Update"/
#	"ThirdPartyFiles" отмечались "passed" — визуально неотличимо от реально
#	пройденной проверки, хотя ничего не проверялось. Теперь непройденные из
#	этих трёх — "failed" (крестик), а разрешение продолжать без них —
#	отдельное правило именно для автономного режима в
#	_fC_UpdateOverallProgress_Ch (см. _vLB_AutonomousMode_Bv). 2026-08-24
#	(правка): УЖЕ пройденные из трёх (например "Server", если провалились
#	только "Update"/"ThirdPartyFiles") больше НЕ откатываются на "failed" —
#	раньше эта функция всегда ставила все три "failed" не глядя, что могло
#	перекрасить в крестик уже честно пройденную проверку
#Форматы данных:
#	Входные: нет
#	Выходные: нет
func _fC_OnAutonomousModePressed_Ch() -> void:
	if vSD_AllNodes_D.has("InfoBoxAutonomousButton"):
		vSD_AllNodes_D["InfoBoxAutonomousButton"]["Node"].visible = false
	if vSD_AllNodes_D.has("InfoBoxRetryButton"):
		vSD_AllNodes_D["InfoBoxRetryButton"]["Node"].visible = false
	_vLB_ServerCheckResolved_Bv = true
	_vLB_AutonomousMode_Bv = true
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnAutonomousModePressed_Ch: продолжаем без сервера", [], null)
	for elLS_Key in AUTONOMOUS_SKIPPED_CHECKS_A:
		if vLD_CheckStatuses_D.get(elLS_Key, "waiting") != "passed":
			fC_SetCheckStatus_Ch(elLS_Key, "failed")
	_fC_ShowInfo_Ch("Работаем в автономном режиме — непройденные проверки пропущены.")


