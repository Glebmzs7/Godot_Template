#Функционал:
#	Строит конфиг под текущую vLS_Orientation_S и создаёт весь экран одним
#	проходом через Class_UI.fC_MassCreatingNode_0001 — она и предназначена
#	для самой первой сборки дерева нод целиком (см. changelog Class_UI.gd).
#	После сборки — донастройка окна Поддержка/Настройки, которую нельзя
#	описать статическим конфигом: подставить сохранённые значения настроек в
#	поля (_fC_ApplySettingsToUI_Ch), построить список языков под текущий
#	поиск (изначально пустой — весь список) и выставить видимость контента
#	под изначально активную категорию
func _fC_BuildScreen_Ch() -> void:
	vXD_CurrentScreenConfig_D = _fC_BuildScreenConfig_Cr(vLS_Orientation_S)
	Class_UI.fC_MassCreatingNode_0001(vXD_CurrentScreenConfig_D, vSD_AllNodes_D)
	_fC_ApplySettingsToUI_Ch()
	_fC_RebuildLanguageList_Ch("")
	_fC_UpdateModalContentVisibility_Ch()
	_fC_UpdateConfirmSourceVisibility_Ch()


#Функционал:
#	Переключает ориентацию экрана на лету — пересобирает конфиг под новую
#	ориентацию и передаёт старый/новый конфиг в fC_SyncingNodesWithConfig_1111,
#	который сам решает, что пересоздать/точечно обновить/удалить (см. её
#	changelog в Class_UI.gd). Готовый механизм под будущий переключатель в
#	настройках — сам переключатель не входит в эту задачу
func fC_SwitchOrientation_Ch(vLS_NewOrientation_S: String) -> void:
	if vLS_NewOrientation_S == vLS_Orientation_S:
		if vLS_StreamId != "":
			Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "fC_SwitchOrientation_Ch: already this orientation, ignored", [vLS_NewOrientation_S], null)
		return
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "fC_SwitchOrientation_Ch: switching", [vLS_Orientation_S, vLS_NewOrientation_S], null)
	var vXD_NewConfig_D: Dictionary = _fC_BuildScreenConfig_Cr(vLS_NewOrientation_S)
	Class_UI.fC_SyncingNodesWithConfig_1111(vSD_AllNodes_D, vXD_CurrentScreenConfig_D, vXD_NewConfig_D)
	vXD_CurrentScreenConfig_D = vXD_NewConfig_D
	vLS_Orientation_S = vLS_NewOrientation_S


#Функционал:
#	Считает, сколько нод-конфигов (словарей с __Data_D/__Inspector_D/__Node_D)
#	есть в дереве конфига — эталон для честной проверки, что интерфейс собрался
#	полностью. Переиспользует Class_UI._fC_IsNodeConfig, чтобы не дублировать
#	правило "что считается нодой". "__Children_D" больше не единственное
#	признанное имя обёртки (см. changelog Class_UI.gd, 2026-08-18) — здесь та же
#	логика: спускаемся в ЛЮБОЙ Dictionary, который сам не нода, независимо от имени
func _fC_CountNodeConfigs_I(vLD_Tree_D: Dictionary) -> int:
	var vLI_Count := 0
	for elLS_Key in vLD_Tree_D:
		if elLS_Key == "__Data_D" or elLS_Key == "__Inspector_D" or elLS_Key == "__Node_D" or elLS_Key == "v__Ebeveyn":
			continue
		var vL_Value = vLD_Tree_D[elLS_Key]
		if typeof(vL_Value) != TYPE_DICTIONARY:
			continue
		if Class_UI._fC_IsNodeConfig(vL_Value):
			vLI_Count += 1
		vLI_Count += _fC_CountNodeConfigs_I(vL_Value)
	return vLI_Count


#Функционал:
#	Честно проверяет, что интерфейс реально собрался целиком: сверяет число
#	нод, фактически оказавшихся в vSD_AllNodes_D, с числом нод-конфигов в
#	vXD_CurrentScreenConfig_D. Расхождение = где-то внутри fC_CreatingNode_1000
#	сработал push_error и вернул {} (несуществующий тип, не найден путь и т.п.)
func _fC_VerifyInterfaceBuilt_Bv() -> bool:
	var vLI_Expected: int = _fC_CountNodeConfigs_I(vXD_CurrentScreenConfig_D)
	var vLI_Actual: int = vSD_AllNodes_D.size()
	if vLI_Actual != vLI_Expected:
		push_warning("⚠️ _fC_VerifyInterfaceBuilt_Bv: создано %d нод из %d ожидаемых" % [vLI_Actual, vLI_Expected])
		return false
	return true


#Функционал:
#	Критическая ошибка на старте (логгер или интерфейс не заработали) —
#	показывает нативное окно ОС (не зависит от нашего Class_UI, который на
#	этом этапе мог и не собраться) и закрывает программу
#Форматы данных:
#	Входные:
#		vLS_Component_S: String — что именно не сработало ("Логгер"/"Интерфейс")
#		vLS_Detail_S: String — подробность для лога и текста окна
func _fC_FatalStartupError_Ch(vLS_Component_S: String, vLS_Detail_S: String) -> void:
	var vLS_Text: String = "Критическая ошибка запуска: %s.\n%s\nПрограмма будет закрыта." % [vLS_Component_S, vLS_Detail_S]
	push_error("⛔ " + vLS_Text)

	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "Fatal startup error: " + vLS_Component_S, [vLS_Detail_S], "push_error")
		Logger.fC_FinishStream_Ch(vLS_StreamId)
		# Форсируем сброс на диск — дальше сразу quit(), обычного автосброса можно не дождаться
		Logger.fC_Saving_Logs_Ch()

	OS.alert(vLS_Text, "Ошибка запуска")
	get_tree().quit()


#Функционал:
#	Некритическая ошибка (программа продолжает работать) — логирует и
#	показывает сообщение в окне информации (InfoBoxLabel), НЕ push_error и НЕ
#	OS.alert/quit (см. changelog 2026-08-19, п.3 ТЗ: "избежать вылета и
#	информировать о проблеме"). В отличие от _fC_FatalStartupError_Ch выше —
#	это для проблем, при которых экран остаётся рабочим (например, не
#	загрузились переводы — тогда просто видны ключи вместо текста, а не крах)
#Форматы данных:
#	Входные:
#		vLS_Component_S: String — что не сработало (например "Локализация")
#		vLS_Detail_S: String — подробность проблемы
func _fC_ReportError_Ch(vLS_Component_S: String, vLS_Detail_S: String) -> void:
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "Non-fatal error: " + vLS_Component_S, [vLS_Detail_S], "error")
	_fC_ShowInfo_Ch("%s: %s" % [vLS_Component_S, vLS_Detail_S])


#Функционал:
#	Публичный API для выставления статуса одной проверки чек-листа — им же
#	будет пользоваться будущая реальная логика (сервер/обновление/сторонние файлы)
#Форматы данных:
#	Входные:
#		vLS_Key: String — ключ из vLA_CheckOrder_A ("Logger","Interface",...)
#		vLS_Status: String — "waiting" / "passed" / "failed"
#		vLS_InfoMessage: String — необязательный текст в окно информации (обычно при "failed")
#	Выходные: нет
func fC_SetCheckStatus_Ch(vLS_Key: String, vLS_Status: String, vLS_InfoMessage: String = "") -> void:
	if not vLD_CheckStatuses_D.has(vLS_Key):
		push_warning("⚠️ fC_SetCheckStatus_Ch: неизвестная проверка '%s'" % vLS_Key)
		return
	if not vGD_StatusSymbols_D.has(vLS_Status):
		push_warning("⚠️ fC_SetCheckStatus_Ch: неизвестный статус '%s'" % vLS_Status)
		return

	vLD_CheckStatuses_D[vLS_Key] = vLS_Status

	var vLS_LabelKey: String = "Row_%s_StatusLabel" % vLS_Key
	if vSD_AllNodes_D.has(vLS_LabelKey):
		var vL_Node = vSD_AllNodes_D[vLS_LabelKey]["Node"]
		vL_Node.text = vGD_StatusSymbols_D[vLS_Status]
		vL_Node.set("theme_override_colors/font_color", vGD_StatusColors_D[vLS_Status])
	else:
		push_warning("⚠️ fC_SetCheckStatus_Ch: нода '%s' не найдена в реестре" % vLS_LabelKey)

	if vLS_Status == "failed" and vLS_InfoMessage != "":
		_fC_ShowInfo_Ch(vLS_InfoMessage)

	_fC_UpdateOverallProgress_Ch()


