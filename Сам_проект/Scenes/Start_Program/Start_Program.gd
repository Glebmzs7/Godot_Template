#Функционал:
#	Копит "хочу применить размер экрана WxH" (2026-08-19, "окно применить/
#	отмена" — размер экрана больше НЕ применяется сразу при вводе/выборе
#	пресета) — выбор КОНКРЕТНОГО размера всегда подразумевает выход из
#	полноэкранного режима (сбрасывает vLB_PendingFullscreen_Bv), совсем как
#	раньше делала сама _fC_ApplyScreenSize_Ch. Взводит vLB_ScreenSizeDirty_Bv
#	через общую _fC_MarkScreenSizeDirty_Ch
#Форматы данных:
#	Входные:
#		vLI_Width_I, vLI_Height_I: int — ожидающий применения размер
func _fC_QueueScreenSizeChange_Ch(vLI_Width_I: int, vLI_Height_I: int) -> void:
	vLI_PendingScreenWidth_I = vLI_Width_I
	vLI_PendingScreenHeight_I = vLI_Height_I
	vLB_PendingFullscreen_Bv = false
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_QueueScreenSizeChange_Ch", [vLI_Width_I, vLI_Height_I], null)
	_fC_MarkScreenSizeDirty_Ch()


#Функционал:
#	Копит "хочу [не] полноэкранный режим" — 2026-08-19, обратная связь
#	"полноэкранный режим не работает через подтверждения": раньше
#	_fC_OnFullscreenToggled_Ch применяла get_window().mode СРАЗУ, в обход
#	всего механизма "применить/отмена". Теперь идёт тем же путём, что и
#	размер (см. _fC_QueueScreenSizeChange_Ch) — ширину/высоту НЕ трогает,
#	они останутся ждать своего часа (пригодятся, когда пользователь позже
#	выключит fullscreen)
#Форматы данных:
#	Входные:
#		vLB_Fullscreen_Bv: bool — новое желаемое состояние fullscreen
func _fC_QueueFullscreenChange_Ch(vLB_Fullscreen_Bv: bool) -> void:
	vLB_PendingFullscreen_Bv = vLB_Fullscreen_Bv
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_QueueFullscreenChange_Ch", [vLB_Fullscreen_Bv], null)
	_fC_MarkScreenSizeDirty_Ch()


#Функционал:
#	Общий хвост для обеих "копилок" выше (_fC_QueueScreenSizeChange_Ch/
#	_fC_QueueFullscreenChange_Ch) — взводит "грязный" флаг (проверяется в
#	_fC_CloseModal_Ch при закрытии настроек) и, если не отключено в категории
#	"Подтверждения", показывает info-окно "применится после закрытия"
func _fC_MarkScreenSizeDirty_Ch() -> void:
	vLB_ScreenSizeDirty_Bv = true
	if vXD_Settings_D.get("ShowScreenChangeInfoPopup", true):
		_fC_ShowScreenInfoPopup_Ch()


#Функционал:
#	Реально применяет размер окна ОС ИЛИ полноэкранный режим (взаимоисключающе)
#	и сохраняет выбор в настройки (п.6 ТЗ: "Надо и изменить окно и сохранить в
#	настройки")
#Форматы данных:
#	Входные:
#		vLI_Width_I, vLI_Height_I: int — размер окна (используется, только
#			если vLB_Fullscreen_Bv=false)
#		vLB_Fullscreen_Bv: bool — true — полноэкранный режим, ширина/высота
#			игнорируются (но сохраняются в настройки как есть, пригодятся,
#			когда пользователь позже выключит fullscreen)
#Принцип работы:
#	⚠️ 2026-08-19 (п.2 ТЗ — жалоба "экран не меняется в размерах"): между
#	переключением mode на MODE_WINDOWED и следующим же изменением .size — один
#	кадр ожидания (await process_frame). Это известная особенность Godot:
#	смена режима окна (особенно ИЗ fullscreen/maximized) обрабатывается ОС
#	асинхронно, и .size, выставленный в ТОМ ЖЕ кадре, что и .mode, иногда
#	тихо игнорируется, пока ОС ещё не закончила применять предыдущую смену
#	режима. Если после этой правки размер всё ещё не меняется — вероятная
#	причина уже не в коде: в редакторе Godot 4.3+ по умолчанию включён "Embed
#	Game" (запускаемая игра встраивается в док редактора вместо настоящего
#	окна ОС), и get_window() в этом режиме не управляет реальным окном —
#	стоит проверить Editor Settings → Run → Window Placement, либо
#	протестировать на экспортированной сборке, а не через "Play" в редакторе
func _fC_ApplyScreenSize_Ch(vLI_Width_I: int, vLI_Height_I: int, vLB_Fullscreen_Bv: bool = false) -> void:
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_ApplyScreenSize_Ch: applying", [vLI_Width_I, vLI_Height_I, vLB_Fullscreen_Bv], null)

	if vLB_Fullscreen_Bv:
		get_window().mode = Window.MODE_FULLSCREEN
	else:
		get_window().mode = Window.MODE_WINDOWED
		await get_tree().process_frame
		get_window().size = Vector2i(vLI_Width_I, vLI_Height_I)

	if vSD_AllNodes_D.has("ScreenFullscreenButton"):
		vSD_AllNodes_D["ScreenFullscreenButton"]["Node"].button_pressed = vLB_Fullscreen_Bv

	vXD_Settings_D["ScreenWidth"] = vLI_Width_I
	vXD_Settings_D["ScreenHeight"] = vLI_Height_I
	vXD_Settings_D["Fullscreen"] = vLB_Fullscreen_Bv
	_fC_SaveSettings_Ch(vXD_Settings_D)


# ============================================================================
# 2026-08-19 — окна "применится после закрытия" (info) и "Применить/Отмена"
# (confirm) для изменения размера экрана. См. changelog в начале файла для
# общей картины; здесь — сами обработчики. Оба окна используют один и тот же
# оверлей-паттерн (_fC_BuildConfirmOverlay_Cr) и один и тот же материал
# размытия, что и большое модальное окно
# ============================================================================

#Функционал:
#	Показывает info-окно "размер экрана применится после закрытия настроек" —
#	вызывается из _fC_QueueScreenSizeChange_Ch при каждом изменении поля/пресета
#	(если не отключено галочкой "больше не показывать")
func _fC_ShowScreenInfoPopup_Ch() -> void:
	if vSD_AllNodes_D.has("ScreenInfoPopupOverlay"):
		vSD_AllNodes_D["ScreenInfoPopupOverlay"]["Node"].visible = true


#Функционал:
#	Кнопка "Понял" на info-окне — просто закрывает его, ничего не применяет
#	(применение размера происходит отдельно, при закрытии настроек)
func _fC_OnScreenInfoOkPressed_Ch() -> void:
