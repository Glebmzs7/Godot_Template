#Функционал:
#	Считает реальный пиксельный размер шрифта под указанный стандартный
#	уровень (vGD_BaseFontSizes_D) — база задана для design-канвы
#	vSV2_Scene_size_V2i (540x900), реальный размер домножается на масштаб
#	ТЕКУЩЕГО окна ОС (2026-08-19, обратная связь: "шрифт должен... зависеть
#	от размеров окна"). round() — не только чтобы размер был целым числом
#	пикселей "для красоты": дробный итоговый размер шрифта — одна из реальных
#	причин размытости текста (см. changelog про "он был не постоянно размыт")
#Форматы данных:
#	Входные:
#		vLS_Tier_S: String — ключ из vGD_BaseFontSizes_D ("Small".."Large")
#	Выходные:
#		int — реальный размер в пикселях, не меньше 8 (страховка от нечитаемо
#			мелкого текста при экстремально маленьком окне)
#Принцип работы:
#	Масштаб — min(ширина_окна/540, высота_окна/900): именно min, а не среднее
#	и не отдельно по X/Y — иначе при сильно "нестандартном" соотношении сторон
#	окна (например, очень широком, но невысоком) текст мог бы вылезти за
#	границы своих контейнеров по высоте. 2026-08-20: ПОВЕРХ этого масштаба
#	домножается ещё и пользовательский vXD_Settings_D["FontScale"] (по
#	умолчанию 1.0, категория "Экран" → ScreenFontScaleLineEdit, п.5 ТЗ) — два
#	независимых множителя: один подстраивается под размер окна автоматически,
#	второй пользователь крутит вручную поверх него
func _fC_FontSize_I(vLS_Tier_S: String) -> int:
	var vLI_Base_I: int = vGD_BaseFontSizes_D.get(vLS_Tier_S, 16)
	var vLV2_WindowSize_V2: Vector2 = Vector2(get_window().size)
	var vLF_ScaleW_F: float = vLV2_WindowSize_V2.x / vSV2_Scene_size_V2i.x
	var vLF_ScaleH_F: float = vLV2_WindowSize_V2.y / vSV2_Scene_size_V2i.y
	var vLF_Scale_F: float = min(vLF_ScaleW_F, vLF_ScaleH_F)
	var vLF_UserFontScale_F: float = vXD_Settings_D.get("FontScale", 1.0)
	return max(8, int(round(vLI_Base_I * vLF_Scale_F * vLF_UserFontScale_F)))


#Функционал:
#	Собирает {ИмяНоды: {"theme_override_font_sizes/font_size": N}} по ВСЕМУ
#	дереву конфига — используется для перерасчёта размеров шрифта при смене
#	размера окна БЕЗ полной пересборки экрана (см. _fC_RescaleFonts_Ch).
#	Переиспользует тот же принцип обхода, что и _fC_CountNodeConfigs_I —
#	спускается в любую Dictionary, которая сама не нода, независимо от имени
#Форматы данных:
#	Входные:
#		vLD_Tree_D: Dictionary — дерево конфига (или его часть)
#	Выходные:
#		Dictionary — плоский {ИмяНоды: {свойство: значение}}, формат, который
#			ожидает Class_UI.fxC_UpdatingExistingNodes_0100
func _fC_CollectFontSizeUpdates_Cr(vLD_Tree_D: Dictionary) -> Dictionary:
	var vLD_Updates_D := {}
	for elLS_Key in vLD_Tree_D:
		if elLS_Key == "__Data_D" or elLS_Key == "__Inspector_D" or elLS_Key == "__Node_D" or elLS_Key == "v__Ebeveyn":
			continue
		var vL_Value = vLD_Tree_D[elLS_Key]
		if typeof(vL_Value) != TYPE_DICTIONARY:
			continue
		if Class_UI._fC_IsNodeConfig(vL_Value):
			var vLD_Inspector_D: Dictionary = vL_Value.get("__Inspector_D", {})
			if vLD_Inspector_D.has("theme_override_font_sizes/font_size"):
				vLD_Updates_D[elLS_Key] = {"theme_override_font_sizes/font_size": vLD_Inspector_D["theme_override_font_sizes/font_size"]}
		vLD_Updates_D.merge(_fC_CollectFontSizeUpdates_Cr(vL_Value))
	return vLD_Updates_D


#Функционал:
#	Живой перерасчёт размеров шрифта под текущий размер окна — вызывается на
#	get_window().size_changed (подключено в _ready()), то есть срабатывает и
#	на ручное перетаскивание края окна, и на наши собственные
#	_fC_ApplyScreenSize_Ch/_fC_OnFullscreenToggled_Ch. НЕ пересобирает экран
#	целиком (ноды/раскладка через anchor и так масштабонезависимы) — строит
#	СВЕЖИЙ конфиг только чтобы получить актуальные числа размеров шрифта
#	(_fC_FontSize_I внутри него уже посчитает их под новый get_window().size)
#	и точечно обновляет через уже существующий Class_UI.fxC_UpdatingExistingNodes_0100
func _fC_RescaleFonts_Ch() -> void:
	var vXD_FreshConfig_D: Dictionary = _fC_BuildScreenConfig_Cr(vLS_Orientation_S)
	var vLD_FontUpdates_D: Dictionary = _fC_CollectFontSizeUpdates_Cr(vXD_FreshConfig_D)
	Class_UI.fxC_UpdatingExistingNodes_0100(vSD_AllNodes_D, vLD_FontUpdates_D)

	# Список языков создаётся НАПРЯМУЮ (не через конфиг, см. changelog
	# _fC_RebuildLanguageList_Ch), поэтому _fC_CollectFontSizeUpdates_Cr его не
	# видит — перестраиваем отдельно, с тем же текстом поиска, что уже введён
	if vSD_AllNodes_D.has("LanguageSearchLineEdit"):
		_fC_RebuildLanguageList_Ch(vSD_AllNodes_D["LanguageSearchLineEdit"]["Node"].text)

	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_RescaleFonts_Ch", [vLD_FontUpdates_D.size()], null)


#Функционал:
#	Материал размытия для ModalOverlay (2026-08-19: "часть что затемняет
#	задний фон — не плохо было бы добавить размытия"). Читает
#	res://Shaders/ModalOverlayBlur.gdshader (шейдер SCREEN_TEXTURE + box-blur,
#	см. сам файл шейдера) — если файл ещё не записан на диск/не грузится,
#	возвращает null, а не падает: ColorRect просто останется однотонным
#	затемнением без размытия, как было раньше (тихая деградация, а не сбой)
#	⚠️ 2026-08-19: blur_amount теперь РАДИУС в пикселях (сэмплы подряд, без
#	дыр) — раньше это был множитель шага между всего 5 сэмплами, из-за чего
#	между сэмплами были дыры и на шрифтах получалась "сетка из точек" (см.
#	changelog самого шейдера). 3.0 подобрано как заметное, но не чрезмерно
#	дорогое размытие (7x7 = 49 сэмплов на пиксель) для статичного экрана
#Форматы данных:
#	Входные: нет
#	Выходные:
#		ShaderMaterial — готов для "material" у ModalOverlay; или null при
#			любой проблеме с загрузкой шейдера
func _fC_ModalOverlayBlurMaterial_Cr() -> ShaderMaterial:
	if not ResourceLoader.exists(FileModalBlurShader):
		return null
	var vL_Shader: Shader = load(FileModalBlurShader)
	if vL_Shader == null:
		return null
	var vL_Material := ShaderMaterial.new()
	vL_Material.shader = vL_Shader
	vL_Material.set_shader_parameter("tint_color", Color(0, 0, 0, 0.55))
	vL_Material.set_shader_parameter("blur_amount", 3.0)
	return vL_Material


#	2026-08-22 - mzs7 - ⚠️ ОТКАЗ ОТ РАЗМЫТИЯ у %sBackdrop (была
#	_fC_ConfirmBackdropBlurMaterial_Cr — своя, более лёгкая версия материала
#	блюра, radius=1.0/alpha=0.30 вместо 3.0/0.55 у большого ModalOverlay,
#	функция удалена). Причина: обратная связь показала на скриншоте, что даже
#	после ослабления та же проблема осталась — сквозь %sBackdrop (окно
#	"Применить/Отмена", как и инфо-окно) виден чек-лист запуска ("Запуск",
#	"Соединение" и т.п. с зелёными галочками) — элемент СТАРТОВОГО экрана,
#	который в принципе не должен быть виден: он должен быть полностью скрыт
#	позади непрозрачной карточки настроек (ModalWindowPanel, alpha=1) и
#	затемнённого/размытого ModalOverlay ЕЩЁ ДО того, как поверх открылся
#	маленький попап. Раз материал самого попапа ПОКАЗЫВАЕТ то, что находится
#	ДВУМЯ слоями глубже (стартовый экран, а не карточку настроек прямо под
#	собой) — дело не в силе размытия/затемнения (это лечится только по
#	касательной), а в том, ЧТО читает SCREEN_TEXTURE в момент отрисовки.
#	Вероятная причина — известное ограничение рендерера Compatibility
#	(project.godot: renderer/rendering_method="gl_compatibility"): экранные
#	шейдеры (hint_screen_texture) в этом рендерере не гарантируют "то, что
#	нарисовано ДО меня В ЭТОМ ЖЕ кадре" так же надёжно, как в Forward+/Mobile
#	— используется бэкбафер откуда-то из предыдущего состояния кадра, и в
#	многослойных сценах (стартовый экран → ModalOverlay → карточка настроек →
#	ещё один попап поверх) он может "видеть" не самый верхний уже
#	нарисованный слой, а более ранний. Чинить сам рендерер/шейдер вслепую (без
#	возможности визуально проверить результат) слишком рискованно — вместо
#	этого %sBackdrop больше ВООБЩЕ не читает экран: material убран, остаётся
#	только собственный плоский цвет (color, alpha=0.45, БЕЗ размытия) —
#	просто закрашенный прямоугольник поверх нужной полосы, гарантированно
#	без любых сюрпризов с тем, что через него "просвечивает". Внешне это
#	чуть менее эффектно (нет стеклянного размытия), зато со 100% надёжностью
#	не покажет ничего постороннего. Большой ModalOverlay (за пределами этого
#	метода) размытие сохраняет — сам по себе он такого бага не показывал, и
#	трогать его без явного запроса не стал ("менять можно только с
#	разрешения") — но если там тоже когда-нибудь "просветит" что-то чужое,
#	причина будет та же самая, и лечится так же (снять material)


#Функционал:
#	"Материал" карточки модального окна (Поддержка/Настройки) — сплошной
#	непрозрачный фон со скруглением. Вынесен в отдельную функцию (п.5 ТЗ
#	2026-08-19: "вынесем создание окна и изменение материала в отдельную
#	функцию, так как будем пользоваться этим часто") — раньше Panel красилась
#	стандартной темой Godot (местами полупрозрачной), из-за чего окно выглядело
#	просвечивающим; теперь стиль один переиспользуемый StyleBoxFlat
#Форматы данных:
#	Входные: нет
#	Выходные:
#		StyleBoxFlat — непрозрачный (alpha=1) фон, готов для
#			"theme_override_styles/panel" у Panel-подобных нод
func _fC_ModalCardStyle_Cr() -> StyleBoxFlat:
	var vL_Style := StyleBoxFlat.new()
	vL_Style.bg_color = Color(0.12, 0.12, 0.15, 1.0) # alpha=1 — гарантированно непрозрачный, не зависит от темы
	vL_Style.set_corner_radius_all(12)
	vL_Style.set_content_margin_all(0)
	return vL_Style


#Функционал:
#	Строит переиспользуемую "рамку" модального окна — саму карточку
#	(ModalWindowPanel, непрозрачная, 80% экрана — п.1 ТЗ 2026-08-19) с
#	заголовком (название СЛЕВА, крестик закрытия СПРАВА — см. changelog про
#	"поменяй местами право и лево") и телом, куда подставляется переданное
#	содержимое. Вынесена отдельно (п.5 ТЗ), чтобы будущие модальные окна
#	(не только Поддержка/Настройки) могли переиспользовать ту же рамку, не
#	копируя разметку заголовка/стиль карточки заново
#Форматы данных:
#	Входные:
#		vLD_BodyChildren_D: Dictionary — {ИмяРебёнка: конфиг_ребёнка (формат
#			_fC_NodeCfg)} — содержимое тела окна, порядок ключей = порядок
#			слева направо внутри ModalBodyHBox
#	Выходные:
#		Dictionary — {"ModalWindowPanel": конфиг_ноды} — один верхнеуровневый
#			ключ, готовый как __Children_D-значение для ModalOverlay
#Принцип работы:
#	Панель занимает 80% экрана через anchor 0.1..0.9 по обеим осям с нулевыми
#	offset — в отличие от фиксированных пиксельных offset'ов (было раньше),
#	такой размер сам пересчитывается под любое разрешение экрана
func _fC_BuildModalChrome_Cr(vLD_BodyChildren_D: Dictionary) -> Dictionary:
	return {
		"ModalWindowPanel": _fC_NodeCfg("Panel", {
			"anchor_left": 0.1, "anchor_top": 0.1,
			"anchor_right": 0.9, "anchor_bottom": 0.9,
			"offset_left": 0, "offset_top": 0, "offset_right": 0, "offset_bottom": 0,
			"theme_override_styles/panel": _fC_ModalCardStyle_Cr(),
		}, {}, {
			"ModalWindowVBox": _fC_NodeCfg("VBoxContainer", {
				"anchor_left": 0.0, "anchor_top": 0.0,
				"anchor_right": 1.0, "anchor_bottom": 1.0,
				"offset_left": 18, "offset_top": 14, "offset_right": -18, "offset_bottom": -14,
				"theme_override_constants/separation": 12,
			}, {}, {
				# Заголовок: название СЛЕВА, крестик закрытия СПРАВА (2026-08-19,
				# п.1 ТЗ — было наоборот, "поменяли местами право и лево")
				# 2026-08-20: ⚠️ БАГ НАЙДЕН И ПОЧИНЕН — "надпись Настройки стала
				# вертикальной, из-за чего сломался UI". Причина: у
				# ModalWindowLabel добавили autowrap_mode (см. changelog 2026-08-20 п.5
				# "перенос текста"), но сам Label остался БЕЗ
				# size_flags_horizontal=3 (EXPAND) — в HBoxContainer весь "лишний"
				# растягиваемый запас забирал соседний ModalHeaderSpacer (у него
				# EXPAND был), а Label ужимался до минимума. У Label С autowrap
				# минимальная ширина — это ширина ОДНОГО символа (а не
				# всего текста, как было без autowrap) — контейнер давал ему
				# именно столько, и "Настройки"/"Поддержка" переносились по
				# букве, столбиком. Исправлено: ModalHeaderSpacer убран целиком,
				# вместо него EXPAND (size_flags_horizontal=3) теперь у самого
				# ModalWindowLabel — он один забирает весь свободный запас
				# (крестик закрытия ModalCloseButton, у которого EXPAND нет,
				# из-за этого сам остаётся прижат к правому краю, как и раньше)
				"ModalHeaderHBox": _fC_NodeCfg("HBoxContainer", {
					"theme_override_constants/separation": 8,
				}, {}, {
					"ModalWindowLabel": _fC_NodeCfg("Label", {
						"autowrap_mode": 3,
						"text": "", # выставляется в _fC_OpenModal_Ch: "SUPPORT_TITLE"/"SETTINGS_TITLE"
						"horizontal_alignment": 0, # LEFT
						"size_flags_horizontal": 3, # EXPAND — см. changelog выше
						"theme_override_font_sizes/font_size": _fC_FontSize_I("Large"),
					}),
					"ModalCloseButton": _fC_NodeCfg("Button", {
						"text": "✕",
						"theme_override_font_sizes/font_size": _fC_FontSize_I("Body"),
					}, {
						"pressed": Callable(self, "_fC_CloseModal_Ch"),
					}),
				}),

				"ModalBodyHBox": _fC_NodeCfg("HBoxContainer", {
					"size_flags_vertical": 3,
					"theme_override_constants/separation": 16,
				}, {}, vLD_BodyChildren_D),
			}),
		}),
	}


#Функционал:
#	Строит переиспользуемую "рамку" МАЛЕНЬКОГО всплывающего окна-уведомления
#	(2026-08-19, "окно применить/отмена") поверх УЖЕ открытого окна Настроек.
#	В отличие от _fC_BuildModalChrome_Cr — без заголовка/крестика, эти окна
#	закрываются только своими собственными кнопками (OK / Применить / Отмена)
#	⚠️ 2026-08-19: ПЕРЕДЕЛАНО по обратной связи "не должно закрывать окно
#	настроек, а должно появляться поверх со своим размытием" — раньше сам
#	Overlay был затемнённым/размытым НА ВЕСЬ ЭКРАН (тем же материалом, что и
#	большой ModalOverlay), из-за чего визуально ПОЛНОСТЬЮ перекрывал/прятал
#	карточку настроек позади себя — выглядело так, будто настройки закрылись
#	и открылось совсем другое окно, а не всплыло поверх. Теперь три слоя:
#	1) Overlay — лёгкое затемнение БЕЗ размытия (color alpha=0.25, без
#	   material), нужен и чтобы ловить клики мимо попапа (mouse_filter=STOP,
#	   не пускает их в поля настроек позади), и чтобы у окна настроек не
#	   оставалось "дыр" — см. следующий абзац;
#	2) Backdrop — размытие+затемнение (тот же материал, что у большого
#	   ModalOverlay), но НЕ на весь экран, а только вокруг самой карточки
#	   (чуть больше её размера) — это и есть "своё размытие" из обратной
#	   связи, локальное, а не поверх всего экрана ещё раз;
#	3) Panel — сама непрозрачная карточка (как раньше)
#	⚠️ 2026-08-20: обратная связь "окна которые должны предупреждать об
#	изменениях делает окно настроек прозрачным по высоте окна" — Backdrop
#	накрывает только среднюю полосу по вертикали (anchor_top/bottom
#	0.28..0.72 = 44% высоты экрана), а Overlay БЫЛ полностью прозрачным
#	(alpha=0) на всех остальных 56% (сверху и снизу от карточки) — окно
#	настроек в этих полосах оставалось совсем НЕ затемнено, "дырой" по всей
#	ширине, что и читалось как "прозрачное по высоте". Раньше (alpha=0) это
#	было сознательным решением — не обесцвечивать/не закрывать окно настроек,
#	но оно перестаралось: не давало ВООБЩЕ никакого визуального намёка, что
#	окно временно неактивно. Теперь Overlay красит ВЕСЬ экран лёгким
#	затемнением (0.25, заметно слабее, чем 0.55 у Backdrop/ModalOverlay) БЕЗ
#	размытия — этого достаточно, чтобы не было "дыр" и полос без затемнения,
#	но недостаточно, чтобы снова выглядеть как "окно настроек закрылось"
#	(контент под 0.25 всё ещё хорошо читается, в отличие от старого дизайна)
#Форматы данных:
#	Входные:
#		vLS_Prefix_S: String — уникальный префикс имён нод этого окна (два вызова
#			с разными префиксами — два независимых окна, "ScreenInfoPopup" и
#			"ScreenApplyConfirm", см. _fC_BuildScreenConfig_Cr)
#		vLD_PanelChildren_D: Dictionary — содержимое карточки (формат _fC_NodeCfg)
#	Выходные:
#		Dictionary — {"<Префикс>Overlay": конфиг_ноды} — один верхнеуровневый
#			ключ, готовый для vLD_Screen_D.merge(...)
func _fC_BuildConfirmOverlay_Cr(vLS_Prefix_S: String, vLD_PanelChildren_D: Dictionary) -> Dictionary:
	return {
		("%sOverlay" % vLS_Prefix_S): _fC_NodeCfg("ColorRect", {
			"anchor_left": 0.0, "anchor_top": 0.0, "anchor_right": 1.0, "anchor_bottom": 1.0,
			"offset_left": 0, "offset_top": 0, "offset_right": 0, "offset_bottom": 0,
			"color": Color(0, 0, 0, 0.25), # лёгкое затемнение (без размытия) — устраняет "дыры" сверху/снизу от Backdrop, см. changelog выше
			"mouse_filter": 0, # STOP — не даёт клику дойти до Settings-полей позади
			"visible": false,
		}, {}, {
			("%sBackdrop" % vLS_Prefix_S): _fC_NodeCfg("ColorRect", {
				"anchor_left": 0.10, "anchor_top": 0.28, "anchor_right": 0.90, "anchor_bottom": 0.72,
				"offset_left": 0, "offset_top": 0, "offset_right": 0, "offset_bottom": 0,
				"color": Color(0, 0, 0, 0.45), # плоское затемнение, БЕЗ material/размытия — см. changelog выше про отказ от SCREEN_TEXTURE здесь
				"mouse_filter": 2, # IGNORE — клики уже перехвачены родительским Overlay целиком
			}),
			("%sPanel" % vLS_Prefix_S): _fC_NodeCfg("Panel", {
				"anchor_left": 0.15, "anchor_top": 0.32, "anchor_right": 0.85, "anchor_bottom": 0.68,
				"offset_left": 0, "offset_top": 0, "offset_right": 0, "offset_bottom": 0,
				"theme_override_styles/panel": _fC_ModalCardStyle_Cr(),
			}, {}, vLD_PanelChildren_D),
		}),
	}


#Функционал:
#	Строит полный конфиг экрана (5 основных блоков + 2 всплывающих окна про
#	размер экрана, см. changelog 2026-08-19 "окно применить/отмена") под
#	указанную ориентацию —
#	CheckList/CompanyIcon различаются по расположению, InfoBox/ModalOverlay/
#	TopButtons одинаковы в обеих раскладках (см. постановку задачи). Весь экран
#	собран ЗДЕСЬ, одним вложенным словарём-литералом (см. changelog 2026-08-19),
#	по образцу vXD_BottomPanel_D/vXD_TopPanel_D в home.gd — раньше каждый блок
#	собирался в отдельной _fC_BuildXNode_Cr-функции, теперь всё видно сразу
#	целиком, без прыжков по функциям. Единственное, что честно приходится
#	собирать циклом ДО литерала — строки чек-листа (vLD_CheckRows_D): их состав
#	берётся из данных (vLA_CheckOrder_A), а не фиксирован, дублировать вручную
#	5 одинаковых по форме строк было бы не проще для понимания, а сложнее
func _fC_BuildScreenConfig_Cr(vLS_TargetOrientation_S: String) -> Dictionary:
	var vLD_CheckListAnchors_D: Dictionary
	var vLD_IconAnchors_D: Dictionary

	# 2026-08-19: ⚠️ ВСЕ anchor-блоки ниже переведены с anchor+offset(px) на ЧИСТЫЙ
	# anchor в долях экрана (offset_* везде 0) — обратная связь: "изменим логику
	# интерфейса с координат на %, чтобы убедиться в работе или отсутствии работы
	# параметров, изменяющих размер деталей". Раньше позиция/размер задавались как
	# "anchor по центру + отступ в пикселях ДИЗАЙН-холста" (540x900,
	# vSV2_Scene_size_V2i) — из-за window/stretch/mode="canvas_items" в
	# project.godot это и так масштабировалось вместе со всем холстом (тот же
	# эффект, что и % при равном соотношении сторон), но при "нестандартном"
	# соотношении сторон окна (canvas_items растягивает по ширине через
	# aspect="keep_width", высота может не совпасть 1-в-1) чистый anchor ведёт
	# себя иначе — независимо по каждой оси. Формула пересчёта пикселей старого
	# смещения в anchor: anchor_ось = старый_anchor_центр ± offset_px / размер_холста_по_оси
	# (540 по ширине, 900 по высоте — те же vSV2_Scene_size_V2i). Внутренние
	# отступы/padding (theme_override_constants/separation, offset_* внутри
	# _fC_BuildModalChrome_Cr) НЕ переведены — это не позиция на экране, а
	# фиксированный зазор между соседними элементами, который при переводе в %
	# от размера уже динамической панели выглядел бы абсурдно (то исчезающе
	# малым, то огромным на разных размерах окна) — если это тоже нужно
	# перевести, дай знать отдельно, это осознанное исключение из "ВСЕХ координат"
	if vLS_TargetOrientation_S == "Horizontal":
		# Чек-лист — на средней линии, слева (0.03..0.42 по ширине — уже было %)
		vLD_CheckListAnchors_D = {
			"anchor_left": 0.03, "anchor_right": 0.42,
			"anchor_top": 0.2556, "anchor_bottom": 0.7444, # было 0.5 ± 220/900
			"offset_left": 0, "offset_right": 0,
			"offset_top": 0, "offset_bottom": 0,
		}
		# Иконка компании — на средней линии, справа
		vLD_IconAnchors_D = {
			"anchor_left": 0.7315, "anchor_right": 0.9685, # было 0.85 ± 64/540
			"anchor_top": 0.4289, "anchor_bottom": 0.5711, # было 0.5 ± 64/900
			"offset_left": 0, "offset_right": 0,
			"offset_top": 0, "offset_bottom": 0,
		}
	else: # "Vertical" — по умолчанию, совпадает с реальным окном проекта
		# Чек-лист — на средней линии, по центру (0.1..0.9 по ширине — уже было %)
		vLD_CheckListAnchors_D = {
			"anchor_left": 0.1, "anchor_right": 0.9,
			"anchor_top": 0.2556, "anchor_bottom": 0.7444, # было 0.5 ± 220/900
			"offset_left": 0, "offset_right": 0,
			"offset_top": 0, "offset_bottom": 0,
		}
		# Иконка компании — сверху по центру
		vLD_IconAnchors_D = {
			"anchor_left": 0.3815, "anchor_right": 0.6185, # было 0.5 ± 64/540
			"anchor_top": 0.0489, "anchor_bottom": 0.1911, # было 0.12 ± 64/900
			"offset_left": 0, "offset_right": 0,
			"offset_top": 0, "offset_bottom": 0,
		}

	# Кнопки поддержки/настроек и окно информации — одинаково в обеих ориентациях
	var vLD_TopButtonsAnchors_D := {
		"anchor_left": 0.5926, "anchor_right": 0.9704, # было 1.0 - 220/540 .. 1.0 - 16/540
		"anchor_top": 0.0178, "anchor_bottom": 0.0711, # было 16/900 .. 64/900
		"offset_left": 0, "offset_right": 0,
		"offset_top": 0, "offset_bottom": 0,
	}
	var vLD_InfoBoxAnchors_D := {
		"anchor_left": 0.08, "anchor_right": 0.92,
		"anchor_top": 0.8, "anchor_bottom": 0.9822, # было 1.0 - 180/900 .. 1.0 - 16/900
		"offset_left": 0, "offset_right": 0,
		"offset_top": 0, "offset_bottom": 0,
	}

	# Строки чек-листа — единственная часть экрана, реально управляемая данными
	# (vLA_CheckOrder_A/vLD_CheckLabels_D/vLD_CheckStatuses_D), а не фиксированной
	# структурой; собираем их заранее, чтобы просто подставить готовый словарь ниже
	var vLD_CheckRows_D := {}
	for elLS_CheckKey in vLA_CheckOrder_A:
		var vLS_InitialStatus: String = vLD_CheckStatuses_D[elLS_CheckKey]
		vLD_CheckRows_D["Row_%s" % elLS_CheckKey] = _fC_NodeCfg("HBoxContainer", {
			"theme_override_constants/separation": 12,
		}, {}, {
			"Row_%s_NameLabel" % elLS_CheckKey: _fC_NodeCfg("Label", {
				"autowrap_mode": 3,
				"text": vLD_CheckLabels_D[elLS_CheckKey],
				"size_flags_horizontal": 3,
				"theme_override_font_sizes/font_size": _fC_FontSize_I("Title"),
			}),
			"Row_%s_StatusLabel" % elLS_CheckKey: _fC_NodeCfg("Label", {
				"autowrap_mode": 3,
				"text": vGD_StatusSymbols_D[vLS_InitialStatus],
				"horizontal_alignment": 1,
				"custom_minimum_size": Vector2(36, 0),
				"theme_override_font_sizes/font_size": _fC_FontSize_I("Title"),
				"theme_override_colors/font_color": vGD_StatusColors_D[vLS_InitialStatus],
			}),
		})

	# 2026-08-23 (правка): окно выбора аккаунта переехало ИЗ полноэкранного
	# модального оверлея (затемнение+карточка по центру) ВНУТРЬ InfoBoxPanel —
	# того самого "отведённого окошка под проверками", которое уже существует
	# для статусных сообщений чек-листа (см. InfoBoxPanel/InfoBoxVBox ниже,
	# обратная связь: "окно должно спрашивать под проверками в отведённом
	# окошке"). Кнопки аккаунтов собраны здесь же, до литерала vLD_Screen_D,
	# по тому же принципу, что и vLD_CheckRows_D выше — состав данные, а не
	# фиксированная структура. Список аккаунтов из vLD_AccountsList_D (файл),
	# в конце ВСЕГДА добавлена кнопка "+" (см. _fC_OnAccountAddButtonPressed_Ch)
	var vLD_AccountButtons_D := {}
	for elLS_Account in vLD_AccountsList_D.keys():
		vLD_AccountButtons_D["AccountPickerButton_%s" % elLS_Account] = _fC_NodeCfg("Button", {
			"text": elLS_Account,
			"size_flags_horizontal": 3,
			"theme_override_font_sizes/font_size": _fC_FontSize_I("Small"),
		}, {
			"pressed": Callable(self, "_fC_OnAccountOptionPressed_Ch").bind(elLS_Account),
		})
	vLD_AccountButtons_D["AccountPickerAddButton"] = _fC_NodeCfg("Button", {
		"text": "+",
		"size_flags_horizontal": 3,
		"theme_override_font_sizes/font_size": _fC_FontSize_I("Small"),
	}, {
		"pressed": Callable(self, "_fC_OnAccountAddButtonPressed_Ch"),
	})

	# Порядок ключей верхнего уровня важен: он же — порядок создания нод, а
	# значит и z-order (последние ключи рисуются поверх предыдущих, и именно они
	# первыми получают клики в этой же области). TopButtonsHBox идёт ДО
	# ModalOverlay специально — оверлей (z_index=0, как и у всех) рисуется
	# поверх ОБЕИХ кнопок и перекрывает клики к ним обеим, как и к остальному
	# экрану, ПОКА окно открыто. ⚠️ 2026-08-19, ещё правка ("не размывается
	# кнопка настроек"): раньше кнопка-источник точечно поднималась над
	# оверлеем через z_index (_fC_SetActiveTopButtonRaised_Ch), из-за чего
	# именно она не затемнялась/не размывалась вместе с остальным экраном —
	# функция удалена, обе кнопки теперь ВСЕГДА одинаково уходят под
	# оверлей, пока он открыт (закрытие — крестик/клик по фону, см.
	# _fC_CloseModal_Ch/_fC_OnOverlayGuiInput_Ch)
	# Каждый ключ верхнего уровня — настоящая нода (без промежуточных
	# групп-обёрток, см. changelog про вложенный формат), дети вложены прямо
	# внутрь через _fC_NodeCfg
	var vLD_Screen_D := {
		"CheckListPanel": _fC_NodeCfg("PanelContainer", vLD_CheckListAnchors_D, {}, {
			"CheckListVBox": _fC_NodeCfg("VBoxContainer", {
				"alignment": 1,
				"theme_override_constants/separation": 10,
			}, {}, vLD_CheckRows_D),
		}),

		"CompanyIconRect": _fC_NodeCfg("TextureRect", _fC_MergeInspector_Cr({
			"texture": load("res://Textures/icon.svg"),
			"expand_mode": 1, # EXPAND_IGNORE_SIZE — размер берётся из anchor/offset, не из текстуры
			"stretch_mode": 5, # STRETCH_KEEP_ASPECT_CENTERED
		}, vLD_IconAnchors_D)),

		"InfoBoxPanel": _fC_NodeCfg("PanelContainer", vLD_InfoBoxAnchors_D, {}, {
			"InfoBoxVBox": _fC_NodeCfg("VBoxContainer", {
				"alignment": 1,
				"theme_override_constants/separation": 8,
			}, {}, {
				"InfoBoxLabel": _fC_NodeCfg("Label", {
					"autowrap_mode": 3,
					"text": "",
					"horizontal_alignment": 1,
					"theme_override_font_sizes/font_size": _fC_FontSize_I("Subtitle"),
				}),
				# 2026-08-24 (обратная связь "когда подключаемся к серверу, в
				# окошке снизу должен появляться таймер, чтобы человек понимал,
				# что подключение работает"): видна ТОЛЬКО пока идёт попытка
				# подключения — от _fC_StartClientConnection_Ch (первая попытка
				# ИЛИ повтор через InfoBoxRetryButton) до момента, когда попытка
				# разрешилась (успехом — _fC_OnServerConnected_Ch — или
				# истечением SERVER_CONNECT_TIMEOUT_SECONDS_F —
				# _fC_OfferAutonomousMode_Ch, дальше место занимают кнопки).
				# Текст обновляется каждый кадр в _process (см. ниже)
				"InfoBoxConnectingLabel": _fC_NodeCfg("Label", {
					"autowrap_mode": 3,
					"text": "",
					"visible": false,
					"horizontal_alignment": 1,
					"theme_override_font_sizes/font_size": _fC_FontSize_I("Small"),
				}),
				# 2026-08-24: текст кнопки "Властвовать" → "Войти" (по просьбе
				# пользователя) — сама кнопка и её поведение не изменились,
				# только подпись (см. _fC_OnProceedPressed_Ch ниже)
				"InfoBoxProceedButton": _fC_NodeCfg("Button", {
					"text": "Войти",
					"visible": false, # появляется только когда все проверки "passed" — см. _fC_UpdateOverallProgress_Ch
					"theme_override_font_sizes/font_size": _fC_FontSize_I("Large"),
				}, {
					"pressed": Callable(self, "_fC_OnProceedPressed_Ch"),
				}),
				# 2026-08-23: кнопка "продолжить без сервера" — появляется при провале
				# ЛЮБОЙ из трёх проверок Server/Update/ThirdPartyFiles (см.
				# _fC_OfferAutonomousMode_Ch/_fC_ShowAutonomousModeButton_Ch) —
				# жмёт непройденные из этих трёх "failed" (крестик, честно — не
				# проверено) вместо бесконечного зависания чек-листа. 2026-08-24
				# (обратная связь "если провалилась ПЕРВАЯ из трёх — предлагаем ЕЩЁ
				# повторить подключение"): для остальных двух (Update/ThirdPartyFiles)
				# повтор подключения ничего бы не исправил (дело не в сети), поэтому
				# InfoBoxRetryButton показывается ТОЛЬКО вместе с этой кнопкой при
				# провале именно "Server" — см. InfoBoxRetryButton ниже
				"InfoBoxAutonomousButton": _fC_NodeCfg("Button", {
					"text": "Продолжить без сервера",
					"visible": false,
					"theme_override_font_sizes/font_size": _fC_FontSize_I("Small"),
				}, {
					"pressed": Callable(self, "_fC_OnAutonomousModePressed_Ch"),
				}),
				# 2026-08-24: кнопка "Повторить подключение" — появляется ТОЛЬКО когда
				# не удалось подключение К СЕРВЕРУ (первая из трёх проверок), рядом с
				# InfoBoxAutonomousButton (см. её changelog выше и _fC_OfferAutonomousMode_Ch/
				# _fC_OnRetryConnectionPressed_Ch) — для Update/ThirdPartyFiles эта
				# кнопка не показывается, повтор подключения их не касается
				"InfoBoxRetryButton": _fC_NodeCfg("Button", {
					"text": "Повторить подключение",
					"visible": false,
					"theme_override_font_sizes/font_size": _fC_FontSize_I("Small"),
				}, {
					"pressed": Callable(self, "_fC_OnRetryConnectionPressed_Ch"),
				}),
				# 2026-08-23 (правка): окно выбора аккаунта теперь здесь, внутри
				# InfoBoxVBox — тот же "отведённый под проверками" блок, что и у
				# InfoBoxLabel/InfoBoxProceedButton выше, а не отдельный
