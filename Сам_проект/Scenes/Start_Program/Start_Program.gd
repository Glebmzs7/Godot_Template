## Ключи проверок, которые в автономном режиме допустимо оставить "failed" и
## всё равно считать общий прогресс пройденным — см. _fC_UpdateOverallProgress_Ch
## и _fC_OnAutonomousModePressed_Ch (обратная связь "если без сети — все крестики")
const AUTONOMOUS_SKIPPED_CHECKS_A := ["Server", "Update", "ThirdPartyFiles"]

#Функционал:
#	Пересчитывает общий прогресс по всем 5 проверкам: если все "passed" —
#	показывает кнопку "Войти" и сообщение об успехе в окне информации.
#	2026-08-23 (правка): в автономном режиме (_vLB_AutonomousMode_Bv)
#	"Server"/"Update"/"ThirdPartyFiles" намеренно "failed" (крестик, см.
#	_fC_OnAutonomousModePressed_Ch), а не "passed" — для них делается
#	исключение из требования "все passed", иначе чек-лист завис бы навсегда.
#	Сообщение об успехе в этом случае НЕ показывается — его уже показал
#	_fC_OnAutonomousModePressed_Ch, и оно точнее ("проверки пропущены", а не
#	"все проверки пройдены" — это было бы неправдой при крестиках на экране)
func _fC_UpdateOverallProgress_Ch() -> void:
	var vLB_AllPassed := true
	for elLS_Key in vLA_CheckOrder_A:
		if vLD_CheckStatuses_D.get(elLS_Key, "waiting") == "passed":
			continue
		if _vLB_AutonomousMode_Bv and elLS_Key in AUTONOMOUS_SKIPPED_CHECKS_A:
			continue
		vLB_AllPassed = false
		break

	if vLB_AllPassed and vSD_AllNodes_D.has("InfoBoxProceedButton"):
		vSD_AllNodes_D["InfoBoxProceedButton"]["Node"].visible = true
		if not _vLB_AutonomousMode_Bv:
			_fC_ShowInfo_Ch("Все проверки пройдены — можно продолжать.")


