#Функционал:
#	Открывает/закрывает общее модальное окно кнопок поддержки/настроек —
#	вызывается только нажатием SupportButton/SettingsButton (та же кнопка
#	закрывает то, что открыла). Закрытие по крестику и по клику на затемнённую
#	область идёт через отдельный _fC_CloseModal_Ch (см. ниже) — общая логика
#	закрытия вынесена туда, чтобы не дублировать её в трёх местах
#Форматы данных:
#	Входные:
#		vLS_Source: String — "Support" или "Settings", кто вызвал переключение
#Принцип работы:
#	⚠️ 2026-08-19, третья правка ("не размывается кнопка настроек"): раньше
#	кнопка-источник поднималась НАД оверлеем через z_index
#	(_fC_SetActiveTopButtonRaised_Ch), чтобы по ней же можно было кликнуть
#	повторно и закрыть окно — но из-за этого именно эта кнопка оставалась
#	не затемнённой и не размытой, пока всё остальное (включая ВТОРУЮ кнопку)
#	уходило под затемнение/размытие ModalOverlay. Теперь, когда закрытие есть
#	ещё и по крестику (_fC_CloseModal_Ch), и по клику мимо окна
#	(_fC_OnOverlayGuiInput_Ch), поднимать кнопку-источник больше не нужно —
#	_fC_SetActiveTopButtonRaised_Ch удалена, ОБЕ кнопки всегда лежат позади
#	ModalOverlay, пока окно открыто, и одинаково затемняются/размываются.
#	Следствие: повторный клик по ТОЙ ЖЕ кнопке, что открыла окно, теперь НЕ
#	закрывает его (клик просто не доходит — перехвачен оверлеем) — закрытие
#	только через крестик или клик по затемнённому/размытому фону
func _fC_ToggleModal_Ch(vLS_Source: String) -> void:
	if not vSD_AllNodes_D.has("ModalOverlay"):
		return

	if vLB_ModalOpen_Bv and vLS_ModalSource_S == vLS_Source:
		_fC_CloseModal_Ch()
	elif not vLB_ModalOpen_Bv:
		_fC_OpenModal_Ch(vLS_Source)
	# else: окно уже открыто ДРУГИМ источником — сюда прийти не должны, т.к.
	# "чужая" кнопка сейчас позади ModalOverlay по z-порядку и не получает клики


#Функционал:
#	Открывает окно от указанного источника: подставляет заголовок (ключ
#	перевода — см. п.8 ТЗ/changelog Class_Localization.gd), показывает
#	категории настроек только у Settings и обновляет видимость содержимого
#	под активную категорию
#Форматы данных:
#	Входные:
#		vLS_Source: String — "Support" или "Settings"
func _fC_OpenModal_Ch(vLS_Source: String) -> void:
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OpenModal_Ch", [vLS_Source], null)
	if vSD_AllNodes_D.has("ModalWindowLabel"):
		vSD_AllNodes_D["ModalWindowLabel"]["Node"].text = "SUPPORT_TITLE" if vLS_Source == "Support" else "SETTINGS_TITLE"
	if vSD_AllNodes_D.has("SettingsCategoriesScroll"):
		# Категории (Язык/Экран/Звук/Подтверждения/Шрифт) нужны только у настроек,
		# не у поддержки. ⚠️ 2026-08-20: скрывается теперь ScrollContainer-обёртка
		# (SettingsCategoriesScroll), а не сам SettingsCategoriesVBox — иначе при
		# видимом, но пустом ScrollContainer'е (когда его единственный ребёнок
		# invisible) под окном поддержки осталась бы пустая полоса-заглушка
		vSD_AllNodes_D["SettingsCategoriesScroll"]["Node"].visible = (vLS_Source == "Settings")
	if vLS_Source == "Settings":
		# 2026-08-19: базовая точка отсчёта "хочу применить" — берём РЕАЛЬНО
		# сохранённое (не то, что могло остаться от прошлого незавершённого
		# редактирования), чтобы, например, "тронул только ширину" не утащил
		# за собой случайный pending fullscreen от предыдущего открытия
		vLI_PendingScreenWidth_I = int(vXD_Settings_D.get("ScreenWidth", vSV2_Scene_size_V2i.x))
		vLI_PendingScreenHeight_I = int(vXD_Settings_D.get("ScreenHeight", vSV2_Scene_size_V2i.y))
		vLB_PendingFullscreen_Bv = vXD_Settings_D.get("Fullscreen", false)
		vLB_ScreenSizeDirty_Bv = false
	vSD_AllNodes_D["ModalOverlay"]["Node"].visible = true
	vLB_ModalOpen_Bv = true
	vLS_ModalSource_S = vLS_Source
	_fC_UpdateModalContentVisibility_Ch()


#Функционал:
#	Закрывает окно Поддержка/Настройки — общая точка для двух способов
#	закрытия (крестик — ModalCloseButton.pressed; клик по затемнённой/
#	размытой области — _fC_OnOverlayGuiInput_Ch), чтобы не дублировать сброс
#	состояния дважды
#	⚠️ 2026-08-19: если размер экрана менялся (vLB_ScreenSizeDirty_Bv), но ещё
#	не применён — настройки НЕ закрываются сразу. Вместо этого либо показывается
#	окно "Применить/Отмена" (и функция выходит, реальное закрытие произойдёт
#	ПОВТОРНЫМ вызовом этой же функции из _fC_CommitScreenSizeChange_Ch/
#	_fC_DiscardPendingScreenSizeChange_Ch, когда vLB_ScreenSizeDirty_Bv уже
#	false), либо — если сам диалог отключён в категории "Подтверждения" —
#	размер применяется тут же молча, без диалога, и закрытие продолжается как
#	обычно (см. changelog "окно применить/отмена")
func _fC_CloseModal_Ch() -> void:
	if not vLB_ModalOpen_Bv or not vSD_AllNodes_D.has("ModalOverlay"):
		return

	if vLB_ScreenSizeDirty_Bv:
		if vXD_Settings_D.get("ShowScreenApplyConfirmPopup", true):
			_fC_ShowScreenApplyConfirm_Ch()
			return
		else:
			vLB_ScreenSizeDirty_Bv = false
			_fC_ApplyScreenSize_Ch(vLI_PendingScreenWidth_I, vLI_PendingScreenHeight_I, vLB_PendingFullscreen_Bv)

	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_CloseModal_Ch", [vLS_ModalSource_S], null)
	vSD_AllNodes_D["ModalOverlay"]["Node"].visible = false
	vLB_ModalOpen_Bv = false
	vLS_ModalSource_S = ""


#Функционал:
#	Обработчик gui_input на самом ModalOverlay (п.2 ТЗ: клик по прозрачной
#	затемнённой части тоже закрывает окно). Клик по самой ModalWindowPanel сюда
#	не доходит — Control останавливает обработку события на первом, кто его
#	принял (Panel сама перехватывает клик, дальше он не идёт), поэтому этот
#	обработчик срабатывает только на настоящем клике МИМО окна
#	⚠️ 2026-08-20 — БАГ НАЙДЕН И ПОЧИНЕН: "окно закрывается при вращении
#	колесика мыши где угодно". Причина — InputEventMouseButton в Godot
#	описывает НЕ ТОЛЬКО обычные клики (ЛКМ/ПКМ/средняя), но и прокрутку
#	колёсика (button_index MOUSE_BUTTON_WHEEL_UP/DOWN/LEFT/RIGHT), у которой
#	тоже выставлен pressed=true на каждый "тик". Старая проверка смотрела
#	ТОЛЬКО на .pressed, поэтому любой тик колёсика над прозрачной областью
#	(а она на весь экран, см. ModalOverlay) читался как "клик мимо окна" и
#	закрывал Настройки/Поддержку. Исправлено — теперь дополнительно
#	проверяется button_index: закрытие срабатывает только на настоящих
#	кнопках мыши (ЛКМ/ПКМ/средняя), колёсико игнорируется
#Форматы данных:
#	Входные:
#		vL_Event: InputEvent — событие от gui_input
func _fC_OnOverlayGuiInput_Ch(vL_Event: InputEvent) -> void:
	if not (vL_Event is InputEventMouseButton) or not vL_Event.pressed:
		return
	# Только настоящие кнопки мыши — колёсико (WHEEL_UP/DOWN/LEFT/RIGHT) НЕ
	# должно закрывать окно, см. changelog выше
	var vLA_RealClickButtons_A: Array = [MOUSE_BUTTON_LEFT, MOUSE_BUTTON_RIGHT, MOUSE_BUTTON_MIDDLE]
	if not vLA_RealClickButtons_A.has(vL_Event.button_index):
		return
	_fC_CloseModal_Ch()


#Функционал:
#	Подставляет уже загруженные настройки (vXD_Settings_D) в поля окна
#	Настройки сразу после его сборки — поля ширины/высоты, состояние кнопки
#	fullscreen, положение и подписи ползунков звука. Без этого при каждом
#	открытии окна поля показывали бы значения по умолчанию из конфига, а не
#	то, что реально сохранено/применено к окну ОС
func _fC_ApplySettingsToUI_Ch() -> void:
	if vSD_AllNodes_D.has("ScreenWidthLineEdit"):
		vSD_AllNodes_D["ScreenWidthLineEdit"]["Node"].text = str(int(vXD_Settings_D.get("ScreenWidth", vSV2_Scene_size_V2i.x)))
	if vSD_AllNodes_D.has("ScreenHeightLineEdit"):
		vSD_AllNodes_D["ScreenHeightLineEdit"]["Node"].text = str(int(vXD_Settings_D.get("ScreenHeight", vSV2_Scene_size_V2i.y)))
	if vSD_AllNodes_D.has("ScreenFullscreenButton"):
		vSD_AllNodes_D["ScreenFullscreenButton"]["Node"].button_pressed = vXD_Settings_D.get("Fullscreen", false)
	if vSD_AllNodes_D.has("ScreenFontScaleLineEdit"):
		vSD_AllNodes_D["ScreenFontScaleLineEdit"]["Node"].text = "%.2f" % float(vXD_Settings_D.get("FontScale", 1.0))

	if vSD_AllNodes_D.has("SoundMusicSlider"):
		vSD_AllNodes_D["SoundMusicSlider"]["Node"].value = vXD_Settings_D.get("MusicVolume", 100)
	if vSD_AllNodes_D.has("SoundMusicValueLabel"):
		vSD_AllNodes_D["SoundMusicValueLabel"]["Node"].text = "%d%%" % int(vXD_Settings_D.get("MusicVolume", 100))
	if vSD_AllNodes_D.has("SoundInterfaceSlider"):
		vSD_AllNodes_D["SoundInterfaceSlider"]["Node"].value = vXD_Settings_D.get("InterfaceVolume", 100)
	if vSD_AllNodes_D.has("SoundInterfaceValueLabel"):
		vSD_AllNodes_D["SoundInterfaceValueLabel"]["Node"].text = "%d%%" % int(vXD_Settings_D.get("InterfaceVolume", 100))

	# 2026-08-19: цветные переключатели категории "Подтверждения" — начальный
	# цвет/подпись под реально сохранённое состояние (см. changelog "окно
	# применить/отмена"), тем же способом, что и остальные поля выше
	_fC_UpdateConfirmToggleVisual_Ch("ConfirmScreenInfoToggle", vXD_Settings_D.get("ShowScreenChangeInfoPopup", true))
	_fC_UpdateConfirmToggleVisual_Ch("ConfirmScreenApplyToggle", vXD_Settings_D.get("ShowScreenApplyConfirmPopup", true))
	_fC_UpdateConfirmToggleVisual_Ch("ConfirmLoggerInfoToggle", vXD_Settings_D.get("ShowLoggerRestartInfoPopup", true))

	# 2026-08-19: поля раздела "Автоматическое нажатие человеком"
	# 2026-08-20: были ползунками (HSlider) — по обратной связи переведены на
	# свободный ввод текста (LineEdit), см. changelog у обработчиков ниже
	var vLF_ProtectionSeconds_F: float = vXD_Settings_D.get("AutoClickProtectionSeconds", 0.5)
	if vSD_AllNodes_D.has("ConfirmAutoClickProtectionLineEdit"):
		vSD_AllNodes_D["ConfirmAutoClickProtectionLineEdit"]["Node"].text = "%.1f" % vLF_ProtectionSeconds_F
	var vLI_DodgeLimit_I: int = int(vXD_Settings_D.get("AutoClickDodgeLimit", 1))
	if vSD_AllNodes_D.has("ConfirmAutoClickDodgeLimitLineEdit"):
		vSD_AllNodes_D["ConfirmAutoClickDodgeLimitLineEdit"]["Node"].text = "%d" % vLI_DodgeLimit_I

	# 2026-08-22: категория "Логи и реплеи" — 6 одинаковых по структуре строк
	# (Enabled-ключ, числовой ключ, ключ ноды-галочки, ключ ноды-поля), поэтому
	# циклом вместо 6 копипаст-блоков — см. vGD_LoggerRows_A (общий список,
	# переиспользуется и в _fC_OnLoggerLimitToggled_Ch/_fC_OnLoggerLimitSubmitted_Ch
	# не нужен, они уже параметризованы через .bind(), список нужен только здесь)
	for elLA_Row_A in vGD_LoggerRows_A:
		_fC_UpdateLoggerCheckVisual_Ch(elLA_Row_A[2], vXD_Settings_D.get(elLA_Row_A[0], true))
		if vSD_AllNodes_D.has(elLA_Row_A[3]):
			vSD_AllNodes_D[elLA_Row_A[3]]["Node"].text = "%d" % int(vXD_Settings_D.get(elLA_Row_A[1], 0))


#Функционал:
#	Показывает содержимое, соответствующее источнику окна (Support — только
#	SupportContentVBox) и активной категории настроек (Language/Screen/Sound —
#	только у Settings), прячет остальное. Единая точка обновления видимости —
#	вызывается и при открытии окна, и при переключении категории
func _fC_UpdateModalContentVisibility_Ch() -> void:
	var vLB_IsSupport_Bv: bool = (vLS_ModalSource_S == "Support")

	if vSD_AllNodes_D.has("SupportContentVBox"):
		vSD_AllNodes_D["SupportContentVBox"]["Node"].visible = vLB_IsSupport_Bv
	if vSD_AllNodes_D.has("LanguageContentVBox"):
		vSD_AllNodes_D["LanguageContentVBox"]["Node"].visible = not vLB_IsSupport_Bv and vLS_ActiveSettingsCategory_S == "Language"
	if vSD_AllNodes_D.has("ScreenContentVBox"):
		vSD_AllNodes_D["ScreenContentVBox"]["Node"].visible = not vLB_IsSupport_Bv and vLS_ActiveSettingsCategory_S == "Screen"
	if vSD_AllNodes_D.has("SoundContentVBox"):
		vSD_AllNodes_D["SoundContentVBox"]["Node"].visible = not vLB_IsSupport_Bv and vLS_ActiveSettingsCategory_S == "Sound"
	if vSD_AllNodes_D.has("ConfirmationsContentVBox"):
		vSD_AllNodes_D["ConfirmationsContentVBox"]["Node"].visible = not vLB_IsSupport_Bv and vLS_ActiveSettingsCategory_S == "Confirmations"
	if vSD_AllNodes_D.has("LoggerContentVBox"):
		vSD_AllNodes_D["LoggerContentVBox"]["Node"].visible = not vLB_IsSupport_Bv and vLS_ActiveSettingsCategory_S == "Logger"


#Функционал:
#	Нажатие одной из кнопок-категорий (Язык/Экран/Звук) — они toggle-кнопки в
#	общем ButtonGroup (_vGC_CategoryButtonGroup), поэтому "toggled" приходит
#	дважды при переключении (false у той, что отжалась, true у новой) — нас
#	интересует только true, иначе vLS_ActiveSettingsCategory_S откатится назад
#Форматы данных:
#	Входные:
#		vLB_Pressed: bool — новое состояние кнопки (сигнал toggled)
#		vLS_Category: String — "Language"/"Screen"/"Sound", привязано через .bind()
func _fC_OnSettingsCategoryToggled_Ch(vLB_Pressed: bool, vLS_Category: String) -> void:
	if not vLB_Pressed:
		return
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnSettingsCategoryToggled_Ch", [vLS_Category], null)
	vLS_ActiveSettingsCategory_S = vLS_Category
	_fC_UpdateModalContentVisibility_Ch()


#Функционал:
#	Перестраивает список языков в LanguageListVBox под текущий текст поиска.
#	⚠️ Единственное место экрана, где ноды создаются НАПРЯМУЮ (Button.new()),
#	а не через Class_UI/конфиг-словарь — список зависит от текста поиска и
#	меняется на каждое нажатие клавиши, статическим конфигом это не описать.
#	Эти кнопки НЕ попадают в vSD_AllNodes_D (не часть статического дерева
#	экрана) — это осознанно, см. _fC_CountNodeConfigs_I/_fC_VerifyInterfaceBuilt_Bv,
#	которые считают только то, что в конфиге, и не должны знать про этот список
#Форматы данных:
#	Входные:
#		vLS_Query_S: String — текущий текст в LanguageSearchLineEdit (может быть "")
#Принцип работы:
#	1. Удаляет все текущие дочерние кнопки списка
#	2. Получает отфильтрованный список локалей через
#	   Class_Localization.fC_FilterLocalesByInputScript_A
#	3. На каждую локаль — toggle-кнопка с текстом-ключом перевода (LANG_RU и
#	   т.п.), общий ButtonGroup (_vGC_LanguageButtonGroup), нажатое состояние
#	   выставлено у текущего выбранного языка (vXD_Settings_D["Locale"])
func _fC_RebuildLanguageList_Ch(vLS_Query_S: String) -> void:
	if not vSD_AllNodes_D.has("LanguageListVBox"):
		return
	var vL_ListNode: VBoxContainer = vSD_AllNodes_D["LanguageListVBox"]["Node"]
	for elL_Child in vL_ListNode.get_children():
		elL_Child.queue_free()

	var vLD_LocaleLabelKeys_D := {
		"ru": "LANG_RU", "en": "LANG_EN", "de": "LANG_DE", "fr": "LANG_FR", "es": "LANG_ES",
	}
	var vLS_CurrentLocale_S: String = vXD_Settings_D.get("Locale", "")
	var vLA_Matches_A: Array = Class_Localization.fC_FilterLocalesByInputScript_A(vLS_Query_S)
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_RebuildLanguageList_Ch", [vLS_Query_S, vLA_Matches_A.duplicate()], null)

	for elLS_Locale in vLA_Matches_A:
		var vL_Button := Button.new()
		vL_Button.text = vLD_LocaleLabelKeys_D.get(elLS_Locale, elLS_Locale)
		vL_Button.toggle_mode = true
		vL_Button.button_group = _vGC_LanguageButtonGroup
		vL_Button.button_pressed = (elLS_Locale == vLS_CurrentLocale_S)
		# Эти кнопки создаются напрямую (не через _fC_NodeCfg), поэтому размер
		# шрифта им нужно выставить отдельно — тем же стандартизированным
		# уровнем, что и у остального текста (см. changelog 2026-08-19 про
		# зависимость шрифта от размера окна)
		vL_Button.add_theme_font_size_override("font_size", _fC_FontSize_I("Body"))
		vL_Button.pressed.connect(Callable(self, "_fC_OnLanguageOptionPressed_Ch").bind(elLS_Locale))
		vL_ListNode.add_child(vL_Button)


#Функционал:
#	text_changed у LanguageSearchLineEdit — просто перестраивает список под
#	новый текст поиска
func _fC_OnLanguageSearchChanged_Ch(vLS_NewText_S: String) -> void:
	_fC_RebuildLanguageList_Ch(vLS_NewText_S)


#Функционал:
#	Нажатие на конкретный язык в списке — переключает locale движка (все
#	переводимые надписи на экране перерисовываются сами, см. changelog
#	Class_Localization.gd про auto_translate_mode) и сохраняет выбор в
#	Settings.json (п.5 ТЗ: "пока просто сохраняя его в настройках")
#Форматы данных:
#	Входные:
#		vLS_Locale: String — код локали ("ru"/"en"/...), привязан через .bind()
func _fC_OnLanguageOptionPressed_Ch(vLS_Locale: String) -> void:
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnLanguageOptionPressed_Ch", [vLS_Locale], null)
	Class_Localization.fC_SetLocale_Ch(vLS_Locale)
	vXD_Settings_D["Locale"] = vLS_Locale
	_fC_SaveSettings_Ch(vXD_Settings_D)


#Функционал:
#	Enter ИЛИ потеря фокуса в поле ширины/высоты (и text_submitted, и
#	focus_exited подключены к одной и той же функции для обоих полей, см.
#	changelog 2026-08-19 п.2 — раньше срабатывало только по Enter) —
#	перечитывает ОБА поля напрямую, а не полагается на переданный текст (он от
#	того поля, где сработал сигнал, а нужны оба сразу)
#	⚠️ 2026-08-19: больше НЕ применяет размер сразу (было _fC_ApplyScreenSize_Ch
#	напрямую) — теперь только копит "хочу применить" через
#	_fC_QueueScreenSizeChange_Ch, реальное применение — при закрытии настроек
#	(см. changelog про окно "Применить/Отмена")
#Форматы данных:
#	Входные:
#		vLS_SubmittedText_S: String — текст/пустая строка от сработавшего
#			сигнала, не используется напрямую — см. выше
func _fC_OnScreenSizeChanged_Ch(vLS_SubmittedText_S: String) -> void:
	if not vSD_AllNodes_D.has("ScreenWidthLineEdit") or not vSD_AllNodes_D.has("ScreenHeightLineEdit"):
		return
	# strip_edges — иначе случайный пробел (частый при копипасте значения)
	# делает is_valid_int() ложноотрицательным, и поле выглядит "сломанным"
	var vLS_WidthText_S: String = vSD_AllNodes_D["ScreenWidthLineEdit"]["Node"].text.strip_edges()
	var vLS_HeightText_S: String = vSD_AllNodes_D["ScreenHeightLineEdit"]["Node"].text.strip_edges()
	if not vLS_WidthText_S.is_valid_int() or not vLS_HeightText_S.is_valid_int():
		if vLS_StreamId != "":
			Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnScreenSizeChanged_Ch: invalid input, ignored", [vLS_WidthText_S, vLS_HeightText_S], null)
		return

	var vLI_Width_I: int = vLS_WidthText_S.to_int()
	var vLI_Height_I: int = vLS_HeightText_S.to_int()
	if vLI_Width_I <= 0 or vLI_Height_I <= 0:
		if vLS_StreamId != "":
			Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnScreenSizeChanged_Ch: non-positive size, ignored", [vLI_Width_I, vLI_Height_I], null)
		return
	_fC_QueueScreenSizeChange_Ch(vLI_Width_I, vLI_Height_I)


#Функционал:
#	Enter ИЛИ потеря фокуса в поле "размер шрифта" (категория "Экран") —
#	сохраняет множитель в настройки и СРАЗУ пересчитывает все шрифты на экране
#	(_fC_RescaleFonts_Ch, тот же метод, что и при живом изменении размера окна).
#	⚠️ НЕ идёт через отложенный apply/cancel механизм ширины/высоты/полного
#	экрана — размер шрифта не входит в список настроек, требующих подтверждения
#	(см. changelog 2026-08-19 "список настроек которые будут вызывать
#	срабатывания этого окна" — там только ширина/высота/пресеты/fullscreen)
#Форматы данных:
#	Входные:
#		vLS_SubmittedText_S: String — текст/пустая строка от сработавшего
#			сигнала, не используется напрямую — поле перечитывается само
func _fC_OnFontScaleSubmitted_Ch(vLS_SubmittedText_S: String) -> void:
	if not vSD_AllNodes_D.has("ScreenFontScaleLineEdit"):
		return
	var vLS_Text_S: String = vSD_AllNodes_D["ScreenFontScaleLineEdit"]["Node"].text.strip_edges()
	if not vLS_Text_S.is_valid_float():
		if vLS_StreamId != "":
			Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnFontScaleSubmitted_Ch: invalid input, ignored", [vLS_Text_S], null)
		return
	# 0.5..3.0 — страховка от нечитаемо мелкого/чудовищно огромного текста
	# при случайной опечатке (например "10" вместо "1.0")
	var vLF_Value_F: float = clamp(vLS_Text_S.to_float(), 0.5, 3.0)
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnFontScaleSubmitted_Ch", [vLF_Value_F], null)
	vXD_Settings_D["FontScale"] = vLF_Value_F
	vSD_AllNodes_D["ScreenFontScaleLineEdit"]["Node"].text = "%.2f" % vLF_Value_F
	_fC_SaveSettings_Ch(vXD_Settings_D)
	_fC_RescaleFonts_Ch()


