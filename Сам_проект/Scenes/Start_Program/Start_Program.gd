		_fC_ShowLoggerInfoPopup_Ch()


#Функционал:
#	Перекрашивает галочку-квадрат под текущее состояние — переиспользует ту же
#	палитру/символы статусов чек-листа (vGD_StatusColors_D/vGD_StatusSymbols_D
#	"passed"/"failed"), что и остальные цветные переключатели этого экрана
#	(см. _fC_UpdateConfirmToggleVisual_Ch — тот же принцип, но там текстовая
#	кнопка "Показывать/Скрыто", здесь квадрат без текста, символ ✓/✗ вместо
#	слова — обратная связь: "галочка (квадрат красно/зелёный)")
#Форматы данных:
#	Входные:
#		vLS_NodeKey_S: String — ключ ноды-галочки в vSD_AllNodes_D
#		vLB_Enabled_Bv: bool — true = лимит включён (зелёный ✓), false =
#			выключен (красный ✗)
#Принцип работы:
#	⚠️ 2026-08-23, найден и починен баг ("окно про логи/реплеи вылезает само
#	при каждом запуске, хотя в настройки не заходил") — та же причина и то же
#	исправление, что и в _fC_UpdateConfirmToggleVisual_Ch выше (см. её
#	подробный changelog): обычное `vL_Button.button_pressed = ...` само
#	испускает "toggled", если значение при программной синхронизации из
#	_fC_ApplySettingsToUI_Ch отличается от дефолта, зашитого в статический
#	конфиг кнопки — а "toggled" здесь подключён к _fC_OnLoggerLimitToggled_Ch,
#	который показывает info-окно "изменения применятся после перезапуска".
#	set_pressed_no_signal — программная синхронизация без повторного сигнала
func _fC_UpdateLoggerCheckVisual_Ch(vLS_NodeKey_S: String, vLB_Enabled_Bv: bool) -> void:
	if not vSD_AllNodes_D.has(vLS_NodeKey_S):
		return
	var vL_Button: Button = vSD_AllNodes_D[vLS_NodeKey_S]["Node"]
	vL_Button.set_pressed_no_signal(vLB_Enabled_Bv)
	vL_Button.text = vGD_StatusSymbols_D["passed"] if vLB_Enabled_Bv else vGD_StatusSymbols_D["failed"]
	vL_Button.modulate = vGD_StatusColors_D["passed"] if vLB_Enabled_Bv else vGD_StatusColors_D["failed"]


#Функционал:
#	Enter ИЛИ потеря фокуса в одном из 6 полей ввода категории "Логи и
#	реплеи" — сохраняет значение в настройки. Тот же generic-паттерн через
#	.bind(), что и у _fC_OnConfirmationToggle_Ch (один обработчик на все 6
#	полей), но текст/фокус сигналы дают строку не единообразно (text_submitted
#	даёт реальный текст, focus_exited — ничего), поэтому, как и у
#	_fC_OnScreenSizeChanged_Ch, поле ПЕРЕЧИТЫВАЕТСЯ САМО по ключу ноды, а не
#	берётся из переданного аргумента — vLS_SubmittedText_S тут не используется
#Форматы данных:
#	Входные:
#		vLS_SubmittedText_S: String — текст/пустая строка от сработавшего
#			сигнала, не используется напрямую (см. выше)
#		vLS_SettingsKey_S: String — числовой ключ в vXD_Settings_D, привязан
#			через .bind() (см. vGD_LoggerRows_A)
#		vLS_NodeKey_S: String — ключ ноды-поля в vSD_AllNodes_D, привязан
#			через .bind()
func _fC_OnLoggerLimitSubmitted_Ch(vLS_SubmittedText_S: String, vLS_SettingsKey_S: String, vLS_NodeKey_S: String) -> void:
	if not vSD_AllNodes_D.has(vLS_NodeKey_S):
		return
	var vLS_Text_S: String = vSD_AllNodes_D[vLS_NodeKey_S]["Node"].text.strip_edges()
	if not vLS_Text_S.is_valid_int():
		if vLS_StreamId != "":
			Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnLoggerLimitSubmitted_Ch: invalid input, ignored", [vLS_SettingsKey_S, vLS_Text_S], null)
		# Невалидный ввод — откатываем поле к реально сохранённому значению,
		# а не оставляем мусор в нём висеть (тот же принцип, что и у полей
		# ширины/высоты экрана)
		vSD_AllNodes_D[vLS_NodeKey_S]["Node"].text = "%d" % int(vXD_Settings_D.get(vLS_SettingsKey_S, 0))
		return
	var vLI_Value_I: int = max(1, vLS_Text_S.to_int()) # минимум 1 — лимит "0" бессмысленен, для отключения есть галочка
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnLoggerLimitSubmitted_Ch", [vLS_SettingsKey_S, vLI_Value_I], null)
	vXD_Settings_D[vLS_SettingsKey_S] = vLI_Value_I
	vSD_AllNodes_D[vLS_NodeKey_S]["Node"].text = "%d" % vLI_Value_I
	_fC_SaveSettings_Ch(vXD_Settings_D) # 2026-08-22: убран случайный повторный вызов этой же строки (был дважды подряд, без эффекта)
	# 2026-08-22: то же info-окно "применится после перезапуска", что и в
	# _fC_OnLoggerLimitToggled_Ch выше — только для реально валидного и
	# сохранённого значения, НЕ при откате невалидного ввода (см. return выше)
	if vXD_Settings_D.get("ShowLoggerRestartInfoPopup", true):
		_fC_ShowLoggerInfoPopup_Ch()


#Функционал:
#	Показывает info-окно "изменения (категория 'Логи и реплеи') применятся
#	только после перезапуска программы" — вызывается из
#	_fC_OnLoggerLimitToggled_Ch/_fC_OnLoggerLimitSubmitted_Ch при каждом
#	реальном изменении одной из 6 настроек (если не отключено галочкой
#	"больше не показывать"). Тот же паттерн, что и у _fC_ShowScreenInfoPopup_Ch
func _fC_ShowLoggerInfoPopup_Ch() -> void:
	if vSD_AllNodes_D.has("LoggerInfoPopupOverlay"):
		vSD_AllNodes_D["LoggerInfoPopupOverlay"]["Node"].visible = true


#Функционал:
#	Кнопка "Понял" на info-окне категории "Логи и реплеи" — просто закрывает
#	его, ничего больше не делает (значения уже сохранены в Settings.json к
#	моменту показа окна — само окно только предупреждает о СРОКЕ применения)
func _fC_OnLoggerInfoOkPressed_Ch() -> void:
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnLoggerInfoOkPressed_Ch", [], null)
	if vSD_AllNodes_D.has("LoggerInfoPopupOverlay"):
		vSD_AllNodes_D["LoggerInfoPopupOverlay"]["Node"].visible = false


#Функционал:
#	Галочка "больше не показывать" на info-окне категории "Логи и реплеи" —
#	сохраняет выбор в настройки и синхронизирует переключатель в категории
#	"Подтверждения" (тот же принцип, что и у _fC_OnScreenInfoDontShowToggled_Ch)
#Форматы данных:
#	Входные:
#		vLB_Pressed: bool — новое состояние галочки (сигнал toggled)
func _fC_OnLoggerInfoDontShowToggled_Ch(vLB_Pressed: bool) -> void:
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnLoggerInfoDontShowToggled_Ch", [vLB_Pressed], null)
	vXD_Settings_D["ShowLoggerRestartInfoPopup"] = not vLB_Pressed
	_fC_SaveSettings_Ch(vXD_Settings_D)
	_fC_UpdateConfirmToggleVisual_Ch("ConfirmLoggerInfoToggle", not vLB_Pressed)
