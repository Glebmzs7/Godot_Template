#Функционал:
#	Галочка "больше не показывать" на info-окне — сохраняет выбор в настройки
#	и синхронизирует цветной переключатель в категории "Подтверждения" (если
#	она уже собрана и открывалась — переключатель должен быть в курсе)
#Форматы данных:
#	Входные:
#		vLB_Pressed: bool — новое состояние галочки (сигнал toggled)
func _fC_OnScreenInfoDontShowToggled_Ch(vLB_Pressed: bool) -> void:
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnScreenInfoDontShowToggled_Ch", [vLB_Pressed], null)
	vXD_Settings_D["ShowScreenChangeInfoPopup"] = not vLB_Pressed
	_fC_SaveSettings_Ch(vXD_Settings_D)
	_fC_UpdateConfirmToggleVisual_Ch("ConfirmScreenInfoToggle", not vLB_Pressed)


#Функционал:
#	Показывает окно "Применить/Отмена" — вызывается из _fC_CloseModal_Ch, когда
#	пользователь пытается закрыть настройки при незаявленном изменении размера
#	экрана. Сбрасывает антидребезг И счётчик "побегов" кнопки "Применить" на
#	каждый новый показ (см. AutoClickDodgeLimit — лимит на показ, не на всю сессию)
#	⚠️ 2026-08-22: вместо сброса "времени прошлого клика" в прошлое (старый
#	баг, см. changelog у _vLF_ApplyButtonUnlockMsec_F) — здесь СТАВИТСЯ
#	дедлайн защиты (сейчас + AutoClickProtectionSeconds) и запускается видимый
#	обратный отсчёт (ScreenApplyConfirmCountdownTimer)
func _fC_ShowScreenApplyConfirm_Ch() -> void:
	if vSD_AllNodes_D.has("ScreenApplyConfirmOverlay"):
		vSD_AllNodes_D["ScreenApplyConfirmOverlay"]["Node"].visible = true
	var vLF_ProtectionSeconds_F: float = vXD_Settings_D.get("AutoClickProtectionSeconds", 0.5)
	_vLF_ApplyButtonUnlockMsec_F = Time.get_ticks_msec() / 1000.0 + vLF_ProtectionSeconds_F
	_vLI_ApplyButtonDodgeCount_I = 0
	_fC_UpdateApplyCountdownDisplay_Ch() # сразу, не дожидаясь первого тика таймера
	if vSD_AllNodes_D.has("ScreenApplyConfirmCountdownTimer") and vLF_ProtectionSeconds_F > 0.0:
		vSD_AllNodes_D["ScreenApplyConfirmCountdownTimer"]["Node"].start()


#Функционал:
#	Прячет окно "Применить/Отмена" — общая точка для обеих кнопок (Применить/
#	Отмена), чтобы не дублировать скрытие дважды. Заодно останавливает таймер
#	обратного отсчёта (2026-08-22) — иначе он тикал бы и после закрытия окна
func _fC_HideScreenApplyConfirm_Ch() -> void:
	if vSD_AllNodes_D.has("ScreenApplyConfirmOverlay"):
		vSD_AllNodes_D["ScreenApplyConfirmOverlay"]["Node"].visible = false
	if vSD_AllNodes_D.has("ScreenApplyConfirmCountdownTimer"):
		vSD_AllNodes_D["ScreenApplyConfirmCountdownTimer"]["Node"].stop()


#Функционал:
#	Тик таймера обратного отсчёта (каждые 0.1с, пока окно открыто и защита ещё
#	действует) — просто перерисовывает счётчик (2026-08-22, см. changelog у
#	_vLF_ApplyButtonUnlockMsec_F)
func _fC_OnApplyCountdownTick_Ch() -> void:
	_fC_UpdateApplyCountdownDisplay_Ch()


#Функционал:
#	Перерисовывает видимый счётчик у кнопки "Применить" — пока текущее время
#	меньше дедлайна защиты (_vLF_ApplyButtonUnlockMsec_F), показывает остаток
#	в секундах; как только дедлайн прошёл — прячет счётчик и останавливает
#	таймер (дальше тикать незачем, защита уже снята) — обратная связь
#	2026-08-22: "счётчик... который будет исчезать по истечении и позволять
#	нажать на кнопку"
func _fC_UpdateApplyCountdownDisplay_Ch() -> void:
	if not vSD_AllNodes_D.has("ScreenApplyConfirmCountdownHBox"):
		return
	var vL_HBox: Control = vSD_AllNodes_D["ScreenApplyConfirmCountdownHBox"]["Node"]
	var vLF_Remaining_F: float = _vLF_ApplyButtonUnlockMsec_F - Time.get_ticks_msec() / 1000.0
	if vLF_Remaining_F <= 0.0:
		vL_HBox.visible = false
		if vSD_AllNodes_D.has("ScreenApplyConfirmCountdownTimer"):
			vSD_AllNodes_D["ScreenApplyConfirmCountdownTimer"]["Node"].stop()
		return
	vL_HBox.visible = true
	if vSD_AllNodes_D.has("ScreenApplyConfirmCountdownValueLabel"):
		vSD_AllNodes_D["ScreenApplyConfirmCountdownValueLabel"]["Node"].text = "%.1f" % vLF_Remaining_F


#Функционал:
#	Нажатие кнопки "Применить" на окне подтверждения — с антидребезгом:
#	пока не прошёл дедлайн защиты (_vLF_ApplyButtonUnlockMsec_F, выставляется
#	при ПОКАЗЕ окна — см. _fC_ShowScreenApplyConfirm_Ch — а не при прошлом
#	клике, см. changelog у самого поля про найденный баг), клик НЕ
#	засчитывается за применение, кнопка "убегает" на случайное место внутри
#	своей зоны — но не больше AutoClickDodgeLimit раз за один показ этого
#	окна (по умолчанию 1), дальше клики проходят как обычные, чтобы
#	пользователь гарантированно мог когда-нибудь применить настройки
func _fC_OnScreenApplyButtonPressed_Ch() -> void:
	var vLI_DodgeLimit_I: int = int(vXD_Settings_D.get("AutoClickDodgeLimit", 1))
	var vLF_Now_F: float = Time.get_ticks_msec() / 1000.0
	if vLF_Now_F < _vLF_ApplyButtonUnlockMsec_F and _vLI_ApplyButtonDodgeCount_I < vLI_DodgeLimit_I:
		_vLI_ApplyButtonDodgeCount_I += 1
		_fC_DodgeApplyButton_Ch()
		if vLS_StreamId != "":
			Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnScreenApplyButtonPressed_Ch: too fast, dodged", [_vLI_ApplyButtonDodgeCount_I, vLI_DodgeLimit_I], null)
		return
	_fC_CommitScreenSizeChange_Ch()


#Функционал:
#	Переставляет кнопку "Применить" на случайную позицию внутри её "арены"
#	(ScreenApplyConfirmArena — обычный Control, не контейнер, поэтому дети
#	не перестраиваются автоматически и position можно двигать вручную)
func _fC_DodgeApplyButton_Ch() -> void:
	if not vSD_AllNodes_D.has("ScreenApplyConfirmArena") or not vSD_AllNodes_D.has("ScreenApplyConfirmApplyButton"):
		return
	var vL_Arena: Control = vSD_AllNodes_D["ScreenApplyConfirmArena"]["Node"]
	var vL_Button: Control = vSD_AllNodes_D["ScreenApplyConfirmApplyButton"]["Node"]
	var vLV2_MaxPos_V2: Vector2 = vL_Arena.size - vL_Button.size
	vLV2_MaxPos_V2.x = max(vLV2_MaxPos_V2.x, 0.0)
	vLV2_MaxPos_V2.y = max(vLV2_MaxPos_V2.y, 0.0)
	vL_Button.position = Vector2(randf() * vLV2_MaxPos_V2.x, randf() * vLV2_MaxPos_V2.y)


#Функционал:
#	Реально применяет отложенный размер экрана (vLI_PendingScreenWidth_I/
#	Height_I) через уже существующую _fC_ApplyScreenSize_Ch, снимает "грязный"
#	флаг, прячет окно подтверждения и НАКОНЕЦ закрывает настройки — повторный
#	вызов _fC_CloseModal_Ch теперь пройдёт целиком, т.к. vLB_ScreenSizeDirty_Bv
#	уже false (см. changelog про _fC_CloseModal_Ch)
func _fC_CommitScreenSizeChange_Ch() -> void:
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_CommitScreenSizeChange_Ch", [vLI_PendingScreenWidth_I, vLI_PendingScreenHeight_I, vLB_PendingFullscreen_Bv], null)
	vLB_ScreenSizeDirty_Bv = false
	_fC_ApplyScreenSize_Ch(vLI_PendingScreenWidth_I, vLI_PendingScreenHeight_I, vLB_PendingFullscreen_Bv)
	_fC_HideScreenApplyConfirm_Ch()
	_fC_CloseModal_Ch()


#Функционал:
#	Нажатие кнопки "Отмена" на окне подтверждения — отбрасывает отложенное
#	изменение (размер И fullscreen), откатывает поля ввода/кнопку fullscreen к
#	реально применённым (сохранённым) значениям и закрывает настройки без применения
func _fC_OnScreenApplyCancelPressed_Ch() -> void:
	if vLS_StreamId != "":
		Logger.fC_Adding_Buffer_Cr(vLS_StreamId, "_fC_OnScreenApplyCancelPressed_Ch", [], null)
	vLB_ScreenSizeDirty_Bv = false
	vLB_PendingFullscreen_Bv = vXD_Settings_D.get("Fullscreen", false)
