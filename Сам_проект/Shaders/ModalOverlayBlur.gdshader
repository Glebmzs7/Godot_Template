// Версия оформления: 0.2.0
// 2026-08-19 - mzs7 - первая версия: размытие того, что видно СКВОЗЬ затемнённый
//	ModalOverlay (окно Поддержка/Настройки, Scenes/Start_Program/Start_Program.gd,
//	см. её же changelog про "часть что затемняет задний фон — добавить размытия").
//	Простой box-blur (5x5 = 25 сэмплов) по SCREEN_TEXTURE, результат смешивается с
//	tint_color тем же способом, что раньше делал ColorRect.color — то есть визуально
//	это "размытое+затемнённое стекло" вместо плоской полупрозрачной заливки.
//	⚠️ Читает экран КАК ЕСТЬ в момент отрисовки — если что-то ещё рисуется поверх
//	этого ColorRect в том же кадре, оно не будет учтено (для статичного экрана
//	настроек, где сзади только чек-лист/иконка/окно информации, это не проблема).
// 2026-08-19 - mzs7 - ⚠️ ИСПРАВЛЕНА ошибка сэмплирования ("размытие делает из
//	шрифтов сетку из точек"): офсеты между 5 сэмплами по каждой оси считались как
//	x * (SCREEN_PIXEL_SIZE * blur_amount) — при blur_amount=5 это шаг В 5 ЦЕЛЫХ
//	ПИКСЕЛЕЙ между соседними сэмплами (сэмплы на -10,-5,0,5,10 px), то есть между
//	ними были ПРОПУСКИ. На высокочастотном содержимом (буквы, тонкие линии) такое
//	разреженное сэмплирование — классический муар/алиасинг, который на глаз и
//	выглядит как решётка из точек, а не как плавное размытие. Исправление: сэмплы
//	теперь идут ПОДРЯД с шагом ровно в 1 текстурный пиксель (SCREEN_PIXEL_SIZE без
//	умножения на blur_amount), а blur_amount — это радиус в пикселях (сколько
//	сэмплов В КАЖДУЮ сторону, а не расстояние между ними), размер кернела теперь
//	(2*radius+1)^2 и растёт вместе с радиусом сам, без дыр. Заодно blur_amount
//	стал понятнее (это буквально "радиус размытия в пикселях экрана"), диапазон
//	уменьшен до 0..6 (radius=6 -> 13x13=169 сэмплов — с запасом хватает для
//	статичного экрана настроек, дальше уже не имеет смысла и дорого)

shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear;
uniform float blur_amount : hint_range(0.0, 6.0) = 3.0; // радиус в пикселях экрана, сэмплы ПОДРЯД (без пропусков)
uniform vec4 tint_color : source_color = vec4(0.0, 0.0, 0.0, 0.55);

void fragment() {
	int vLI_Radius = clamp(int(round(blur_amount)), 0, 8);
	vec4 vL_Blurred = vec4(0.0);
	float vLF_TotalWeight = 0.0;

	for (int x = -vLI_Radius; x <= vLI_Radius; x++) {
		for (int y = -vLI_Radius; y <= vLI_Radius; y++) {
			// Шаг РОВНО в 1 текстурный пиксель — сэмплы подряд, без дыр между ними
			// (см. changelog выше про "сетку из точек")
			vec2 vLV2_Offset = vec2(float(x), float(y)) * SCREEN_PIXEL_SIZE;
			vL_Blurred += textureLod(screen_texture, SCREEN_UV + vLV2_Offset, 0.0);
			vLF_TotalWeight += 1.0;
		}
	}
	vL_Blurred /= vLF_TotalWeight;

	COLOR = mix(vL_Blurred, tint_color, tint_color.a);
	COLOR.a = 1.0;
}
